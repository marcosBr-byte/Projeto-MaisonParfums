<div class="min-h-screen bg-[#F7F7F5] px-4 py-12">
  <div class="mx-auto max-w-3xl">

    <%= link_to root_path, class: "text-sm text-[#748A9C] transition hover:text-[#485057]" do %>
      ← Voltar para a loja
    <% end %>

    <div class="mb-8 mt-8">
      <p class="mb-2 text-xs uppercase tracking-[0.3em] text-[#748A9C]">Maison Parfum</p>
      <h1 class="font-serif text-3xl text-[#485057] md:text-4xl">Central de Atendimento</h1>
      <p class="mt-3 text-sm leading-6 text-stone-500">Precisa de ajuda com seu pedido? Envie sua mensagem e nossa equipe irá atendê-lo.</p>
    </div>
    <div class="rounded-2xl border border-[#E5E6E7] bg-white p-6 shadow-sm md:p-8">
      <% if @mensagem.errors.any? %>
        <div class="mb-6 rounded-lg bg-red-50 p-4 text-sm text-red-700">
          <% @mensagem.errors.full_messages.each do |erro| %>
            <p><%= erro %></p>
          <% end %>
        </div>
      <% end %>

      <%= form_with model: @mensagem, url: mensagens_path, class: "space-y-6" do |f| %>
        <div>
          <%= f.label :nome, "Nome", class: "mb-2 block text-sm font-medium text-[#485057]" %>
          <%= text_field_tag :nome, current_usuario.nome, disabled: true, class: "w-full rounded-lg border border-[#D0D3D6] bg-gray-100 p-3 text-sm text-gray-500" %>
        </div>

        <div>
          <%= f.label :email, "E-mail", class: "mb-2 block text-sm font-medium text-[#485057]" %>
          <%= email_field_tag :email, current_usuario.email, disabled: true, class: "w-full rounded-lg border border-[#D0D3D6] bg-gray-100 p-3 text-sm text-gray-500" %>
        </div>

        <div>
          <%= f.label :pedido_id, "Pedido relacionado (opcional)", class: "mb-2 block text-sm font-medium text-[#485057]" %>
          <%= f.collection_select :pedido_id, @pedidos, :id, :id, { include_blank: "Não está relacionado a um pedido específico" }, class: "w-full rounded-lg border border-[#D0D3D6] bg-white p-3 text-sm focus:border-[#748A9C] focus:outline-none" %>
        </div>

        <div>
          <%= f.label :assunto, "Assunto", class: "mb-2 block text-sm font-medium text-[#485057]" %>
          <%= f.select :assunto,
              [
                ["Dúvida sobre meu pedido", "Dúvida sobre meu pedido"],
                ["Acompanhar entrega", "Acompanhar entrega"],
                ["Problema com pagamento", "Problema com pagamento"],
                ["Produto recebido com problema", "Produto recebido com problema"],
                ["Troca ou cancelamento", "Troca ou cancelamento"],
                ["Outros assuntos", "Outros assuntos"]
              ],
              { prompt: "Selecione o assunto" }, class: "w-full rounded-lg border border-[#D0D3D6] bg-white p-3 text-sm focus:border-[#748A9C] focus:outline-none" %>
        </div>

        <div>
          <%= f.label :conteudo, "Sua mensagem", class: "mb-2 block text-sm font-medium text-[#485057]" %>
          <%= f.text_area :conteudo, rows: 6, placeholder: "Descreva como podemos ajudar...", class: "w-full rounded-lg border border-[#D0D3D6] p-3 text-sm focus:border-[#748A9C] focus:outline-none" %>
        </div>
        <div class="pt-2">
          <%= f.submit "Enviar mensagem",class: "w-full cursor-pointer rounded-lg bg-[#485057] px-6 py-3 text-sm font-medium text-white transition hover:bg-[#343A40] md:w-auto" %>
        </div>
      <% end %>
    </div>

    <p class="mt-6 text-center text-xs text-stone-400">
      Maison Parfum — Estamos à disposição para ajudar.
    </p>

  </div>
</div>

