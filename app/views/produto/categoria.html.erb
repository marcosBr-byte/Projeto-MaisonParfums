<% content_for :title, "#{@titulo} · Maison Parfum" %>
<section class="max-w-7xl mx-auto px-4 sm:px-6 py-12">
  <%= link_to "← Todos os produtos", produtos_todos_path, class: "text-sm text-[#485057] underline" %>
  <h1 class="font-serif text-4xl text-[#485057] mt-4 mb-8"><%= @titulo %></h1>
  <nav class="catalog-filters mb-8" aria-label="Filtrar por público">
    <% [[nil, "Todos"], *Produto::PUBLICOS.to_a].each do |valor, nome| %>
      <%= link_to nome, url_for(only_path: true, publico: valor), class: "catalog-filter #{'catalog-filter--active' if @publico == valor}", aria: { current: (@publico == valor ? "page" : nil) } %>
    <% end %>
  </nav>
  <%= render "lista_categoria", produtos: @produtos %>
</section>
