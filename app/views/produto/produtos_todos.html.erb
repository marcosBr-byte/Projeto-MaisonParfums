<div class="min-h-screen bg-[#F7F7F5]">
  <div class="max-w-7xl mx-auto px-6 py-12">

    <div class="text-center mb-16">
      <p class="text-xs uppercase tracking-[0.3em] text-[#748A9C]">Maison Parfum</p>
      <h1 class="font-serif text-4xl md:text-5xl text-[#343A40] mt-3">Todos os Produtos</h1>

      <p class="text-[#748A9C] mt-4">Encontre sua próxima fragrância.</p>
    </div>
    <% [["Decantes Masculinos", @masculinos], ["Decantes Femininos", @femininos], ["Decantes Unissex", @unissex],
         ["Decantes Nicho", @nichos], ["Body Splash", @body_splashes], ["Hidratantes", @hidratantes]].each do |titulo, produtos| %>
      <section class="mb-12">
        <h2 class="font-serif text-3xl text-[#343A40] mb-8"><%= titulo %></h2>
        <%= render "lista_categoria", produtos: produtos %>
      </section>
    <% end %>
  </div>
</div>
