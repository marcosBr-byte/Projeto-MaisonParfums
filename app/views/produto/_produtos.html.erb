<%= link_to produto_path(produto), id: dom_id(produto), class: "block border border-stone-200 p-4 hover:shadow-md transition" do %>
  <h3 class="font-serif text-lg text-marinho"><%= produto.nome %></h3>
  <p class="text-sm text-stone-600"><%= Produto.tamanhos[produto.tamanho] %></p>
  <p class="text-lg font-semibold"><%= number_to_currency(produto.preco) %></p>
<% end %>
