<% variantes = produto.variantes.sort_by { |v| v.preco || 0 } %>
<% detalhes = [produto.rotulo(:categoria), Produto::PUBLICOS[produto.publico], produto.rotulo(:fragancia)].compact_blank %>
<% disponivel = variantes.any?(&:disponivel?) %>
<% percentual = configuracao_loja.percentual_vigente %>
<% avaliacoes = produto.avaliacoes_publicadas.to_a %>
<%= link_to produto_path(produto), id: dom_id(produto), class: "catalog-card #{local_assigns[:card_class]}" do %>
  <div class="catalog-card__image">
    <% if produto.imagem.attached? %>
      <%= image_tag imagem_loja(produto.imagem, tamanho: :catalogo), alt: produto.nome, loading: "lazy", decoding: "async" %>
    <% else %>
      <div class="catalog-card__placeholder"><span class="material-symbols-outlined" aria-hidden="true">water_drop</span><span>Imagem em breve</span></div>
    <% end %>
    <% if Produto::ORIGENS[produto.origem] %><span class="catalog-card__origin"><%= Produto::ORIGENS[produto.origem] %></span><% end %>
    <% if percentual.positive? && produto.preco.present? %>
      <span class="catalog-card__promotion"><%= number_to_percentage(percentual, precision: 2, strip_insignificant_zeros: true, separator: ",") %> OFF</span>
    <% end %>
    <% unless disponivel %><span class="catalog-card__sold-out">Esgotado</span><% end %>
  </div>
  <div class="catalog-card__body">
    <% if produto.marca.present? %><p class="catalog-card__brand"><%= produto.marca %></p><% end %>
    <%= content_tag(local_assigns.fetch(:heading_tag, :h3), produto.nome, class: "catalog-card__name") %>
    <% if avaliacoes.any? %>
      <div class="catalog-card__rating">
        <%= estrelas_avaliacao(avaliacoes.sum(&:nota).fdiv(avaliacoes.size)) %>
        <span aria-label="<%= pluralize(avaliacoes.size, "avaliação", "avaliações") %>">(<%= avaliacoes.size %>)</span>
      </div>
    <% end %>
    <% if detalhes.any? %><p class="catalog-card__details"><%= detalhes.join(" · ") %></p><% end %>
    <% if variantes.any? %>
      <div class="catalog-card__sizes" aria-label="Tamanhos disponíveis">
        <% variantes.each do |variante| %>
          <span class="catalog-card__size <%= 'catalog-card__size--unavailable' unless variante.disponivel? %>" <%= tag.attributes(title: "Tamanho esgotado") unless variante.disponivel? %>><%= rotulo_tamanho_variante(variante) %><%= " · esgotado" unless variante.disponivel? %></span>
        <% end %>
      </div>
    <% end %>
    <div class="catalog-card__footer">
      <% if produto.preco.present? %>
        <% preco = preco_loja(produto) %>
        <% if percentual.positive? %>
          <p class="catalog-card__discount"><del><%= moeda_loja(produto.preco) %></del></p>
        <% end %>
        <p class="catalog-card__price"><% if variantes.size > 1 %><span>A partir de</span><% end %><strong><%= moeda_loja(preco) %></strong></p>
        <%# A prévia local simula as condições solicitadas até o checkout aplicar os mesmos valores. %>
        <% if Rails.env.local? %>
          <p class="catalog-card__installments">3x de <%= moeda_loja(preco / 3) %> sem juros</p>
          <p class="catalog-card__pix"><strong><%= moeda_loja((preco * BigDecimal("0.915")).round(2)) %></strong> no Pix</p>
        <% end %>
      <% end %>
      <span class="catalog-card__action"><%= disponivel ? "Comprar" : "Ver produto" %> <span aria-hidden="true">↗</span></span>
    </div>
  </div>
<% end %>
