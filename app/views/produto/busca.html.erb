<div class="min-h-screen bg-[#F7F7F5]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 md:py-14">
    <div class="mb-10">
      <p class="text-xs uppercase tracking-[0.3em] text-[#748A9C] mb-3">Maison Parfum</p>
      <% if @termo.present? %>
        <h1 class="font-serif text-3xl md:text-4xl text-[#485057]">Resultados da busca</h1>
        <p class="mt-3 text-sm md:text-base text-[#748A9C]">Você pesquisou por:<span class="font-semibold text-[#485057]">"<%= @termo %>"</span></p>

      <% else %>
        <h1 class="font-serif text-3xl md:text-4xl text-[#485057]">Encontre sua fragrância</h1>
        <p class="mt-3 text-sm md:text-base text-[#748A9C]">Explore os perfumes e descubra sua próxima fragrância favorita.</p>
      <% end %>
      <div class="w-16 h-1 bg-[#B8BDC3] mt-5"></div>
    </div>
    <% if @termo.present? && @produtos.any? %>
      <div class="flex items-center justify-between mb-6">
        <p class="text-sm text-[#485057]"><%= @produtos.size %>
        <%= @produtos.size == 1 ? "perfume encontrado" : "perfumes encontrados" %></p>
      </div>
    <% end %>

   
    <% if @produtos.any? %>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-5 md:gap-7">
        <%= render partial: "produto/produtos", collection: @produtos, as: :produto %>
      </div>
    <% elsif @termo.present? %>
      <div class="bg-white border border-[#E5E6E7] rounded-2xl px-6 py-14 text-center">
        <div class="flex justify-center mb-5">
          <div class="w-16 h-16 rounded-full bg-[#F7F7F5] flex items-center justify-center">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7 text-[#748A9C] "fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"> <circle cx="11" cy="11" r="7" /><path stroke-linecap="round" d="m16 16 4 4" /></svg>
          </div>
        </div>
        <h2 class="font-serif text-2xl text-[#485057] mb-3">Nenhum perfume encontrado</h2>
        <p class="text-sm text-gray-500 max-w-md mx-auto leading-relaxed">Não encontramos fragrâncias com esse nome. Experimente pesquisar por outro perfume ou verificar a escrita.</p>
        <%= link_to "Ver todos os perfumes", produtos_path, class: "inline-block mt-7 px-6 py-3 rounded-full bg-[#485057] text-white text-sm hover:bg-[#748A9C] transition duration-300" %>
      </div>

    <!-- Busca ainda vazia -->
    
    <% else %>
      <div class="bg-white border border-[#E5E6E7] rounded-2xl px-6 py-10 md:py-14 text-center">
        <p class="text-xs uppercase tracking-[0.3em] text-[#748A9C] mb-3">Maison Parfum</p>
        <h2 class="font-serif text-2xl md:text-3xl text-[#485057] mb-3">Encontre sua próxima fragrância</h2>
        <p class="text-sm text-gray-500 max-w-md mx-auto mb-8">Pesquise pelo nome do perfume ou explore nossa coleção para descobrir sua próxima fragrância favorita.</p>

        
        <%= link_to produtos_todos_path, class: "inline-flex items-center justify-center gap-2 px-8 py-3.5 rounded-full border border-[#B8BDC3] text-[#485057] text-sm font-medium hover:bg-[#E5E6E7] transition duration-300" do %>
          <span>Ver todos os produtos</span>
          <span aria-hidden="true">→</span>
        <% end %>

      </div>
    <% end %>
  </div>
</div>
