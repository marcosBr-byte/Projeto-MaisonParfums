<div class="max-w-3xl mx-auto px-4 py-10">
  <%= link_to "← Voltar", admin_path, class: "text-sm text-stone-600 hover:text-marinho" %>
  <h1 class="font-serif text-3xl text-marinho my-6">Frascos Mãe</h1>

  <% if notice %>
    <p class="text-green-700 mb-4"><%= notice %></p>
  <% end %>

  <%= link_to "Novo Frasco Mãe", new_frasco_mae_path, class: "inline-block bg-black text-white px-4 py-2 mb-6" %>

  <table class="w-full text-left">
    <thead>
      <tr class="border-b border-stone-300">
        <th class="py-2">Perfume</th>
        <th class="py-2">Estoque (ml)</th>
        <th class="py-2"></th>
      </tr>
    </thead>
    <tbody>
      <% @frascos.each do |frasco| %>
        <tr class="border-b border-stone-200">
          <td class="py-2"><%= frasco.nome %></td>
          <td class="py-2"><%= frasco.estoque_ml %> ml</td>
          <td class="py-2 text-right">
            <%= link_to "Editar", edit_frasco_mae_path(frasco), class: "text-stone-600 hover:text-marinho mr-4" %>
            <%= button_to "Excluir", frasco_mae_path(frasco), method: :delete, form: { data: { turbo_confirm: "Excluir este frasco?" }, class: "inline" }, class: "text-red-700" %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>

  <% if @frascos.empty? %>
    <p class="text-stone-600 mt-6">Nenhum frasco cadastrado ainda.</p>
  <% end %>
</div>
