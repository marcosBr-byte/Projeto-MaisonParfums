<div class="mx-auto max-w-5xl px-4 py-10 sm:px-6">

  <%= link_to admin_path, class: "inline-flex items-center gap-2 text-sm text-stone-500 transition hover:text-amber-700" do %>
    <span>←</span>
    <span>Voltar ao painel</span>
  <% end %>

  <div class="mb-8 mt-6 flex flex-col justify-between gap-5 sm:flex-row sm:items-end">
    <div>
      <p class="mb-2 text-xs uppercase tracking-[0.3em] text-[#748A9C]">Maison Parfum</p>
      <h1 class="font-serif text-3xl text-[#485057] md:text-4xl">Frascos Mãe</h1>
      <p class="mt-3 text-sm leading-6 text-stone-500">Gerencie os perfumes e acompanhe o estoque disponível.</p>
    </div>

    <%= link_to new_frasco_mae_path, class: "inline-flex items-center justify-center gap-2 rounded-lg bg-[#485057] px-5 py-3 text-sm font-medium text-white shadow-sm transition hover:bg-[#748A9C]" do %>
      <span class="text-lg">+</span>Novo Frasco Mãe
    <% end %>
  </div>

  <% if notice.present? %>
    <div class="mb-6 flex items-center gap-3 rounded-lg border border-green-200 bg-green-50 px-4 py-3 text-sm text-green-800">
      <span class="font-bold">✓</span>
      <p><%= notice %></p>
    </div>
  <% end %>

  <div class="overflow-hidden rounded-xl border border-stone-200 bg-white shadow-sm">
    <div class="flex items-center justify-between border-b border-stone-200 px-6 py-5">
      <div>
        <h2 class="font-serif text-xl font-semibold text-stone-900">Estoque de perfumes</h2>
        <p class="mt-1 text-sm text-stone-500">Consulte e gerencie seus frascos cadastrados.</p>
      </div>

      <span class="rounded-full bg-amber-50 px-3 py-1 text-xs font-semibold text-amber-800">
        <%= @frascos.size %> cadastrados
      </span>
    </div>

    <% if @frascos.any? %>
      <div class="overflow-x-auto">
        <table class="w-full text-left text-sm">
          <thead class="bg-stone-50 text-xs uppercase tracking-wider text-stone-500">
            <tr>
              <th class="px-6 py-4 font-semibold">Perfume</th>
              <th class="px-6 py-4 font-semibold">Estoque</th>
              <th class="px-6 py-4 text-right font-semibold">Ações</th>
            </tr>
          </thead>

          <tbody class="divide-y divide-stone-100">

            <% @frascos.each do |frasco| %>
              <tr class="transition hover:bg-stone-50">
                <td class="px-6 py-5">
                  <span class="font-medium text-stone-900">
                    <%= frasco.nome %>
                  </span>
                </td>

                <td class="whitespace-nowrap px-6 py-5">
                  <span class="font-medium text-stone-700">
                    <%= frasco.estoque_ml %> ml
                  </span>
                </td>

                <td class="px-6 py-5">
                  <div class="flex items-center justify-end gap-3">
                    <%= link_to edit_frasco_mae_path(frasco), class: "rounded-lg border border-stone-300 px-4 py-2 text-xs font-semibold text-stone-700 transition hover:border-amber-600 hover:text-amber-700" do %>Editar
                    <% end %>
                    <%= button_to "Excluir", frasco_mae_path(frasco), method: :delete, form: {class: "inline-block", data: { turbo_confirm: "Tem certeza que deseja excluir este frasco?"}},class: "rounded-lg border border-red-200 px-4 py-2 text-xs font-semibold text-red-600 transition hover:bg-red-50" %>
                  </div>
                </td>
              </tr>
            <% end %>

          </tbody>
        </table>
      </div>

    <% else %>

      <div class="px-6 py-16 text-center">
        <h3 class="font-serif text-xl font-semibold text-stone-800">Nenhum frasco cadastrado </h3>
        <p class="mx-auto mt-2 max-w-sm text-sm leading-6 text-stone-500"> Seu estoque ainda está vazio. Cadastre seu primeiro frasco mãe para começar a gerenciar seus perfumes.</p>
        <%= link_to "Cadastrar primeiro frasco", new_frasco_mae_path, class: "mt-6 inline-flex rounded-lg bg-[#748A9C] px-5 py-3 text-sm font-medium text-white transition hover:bg-[#D9DDE0]" %>
      </div>
    <% end %>

    <div class="border-t border-stone-200 bg-stone-50 px-6 py-4">
      <p class="text-xs text-stone-500"> Maison Parfum · Gerenciamento de estoque</p>
    </div>

  </div>
</div>
