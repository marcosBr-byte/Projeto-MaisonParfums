<% content_for :title, "Descubra seu perfume · Maison Parfum" %>
<section class="max-w-3xl mx-auto px-4 sm:px-6 py-12">
  <%= link_to "← Voltar à loja", root_path, class: "text-sm text-[#748A9C]" %>
  <div class="text-center mt-8 mb-8">
    <p class="text-xs uppercase tracking-[0.3em] text-[#748A9C]">Seu perfil olfativo</p>
    <h1 class="font-serif text-3xl md:text-4xl text-[#485057] mt-3">Uma fragrância que combina com você</h1>
    <p class="text-[#748A9C] mt-4">Quatro perguntas para descobrir sugestões do nosso catálogo. Sem cadastro, no seu ritmo.</p>
  </div>
  <%= form_with model: @quiz, url: quiz_path, method: :post, novalidate: true, class: "rounded-2xl border border-[#E5E6E7] bg-white p-6 sm:p-9 shadow-sm", data: { controller: "quiz", action: "submit->quiz#enviar" } do |form| %>
    <% if @quiz.errors.any? %>
      <div role="alert" class="mb-6 rounded-xl border border-red-200 bg-red-50 p-4 text-red-700">
        <p>Revise suas respostas antes de continuar:</p>
        <ul class="list-disc pl-5"><% @quiz.errors.full_messages.each do |erro| %><li><%= erro %></li><% end %></ul>
      </div>
    <% end %>
    <div hidden data-quiz-target="progresso" class="mb-7" aria-live="polite">
      <p data-quiz-target="contador" class="text-sm text-[#748A9C] mb-3"></p>
      <progress data-quiz-target="barra" max="<%= PerfumeQuiz::PERGUNTAS.size %>" value="1" aria-label="Progresso do quiz" class="w-full h-2 accent-[#485057]"></progress>
    </div>
    <% PerfumeQuiz::PERGUNTAS.each_with_index do |(campo, pergunta), index| %>
      <fieldset data-quiz-target="etapa" data-campo="<%= campo %>" class="mb-8">
        <legend tabindex="-1" class="font-serif text-2xl text-[#485057]"><%= index + 1 %>. <%= pergunta[:titulo] %></legend>
        <p class="text-sm text-[#748A9C] mt-3 mb-5"><%= pergunta[:ajuda] %></p>
        <div class="grid sm:grid-cols-2 gap-3">
          <% pergunta[:opcoes].each do |valor, rotulo| %>
            <label class="relative cursor-pointer">
              <% if campo == :familias %>
                <%= check_box_tag "perfume_quiz[familias][]", valor, Array(@quiz.familias).include?(valor), id: "quiz_familia_#{valor}", class: "peer sr-only", data: { action: "change->quiz#limparErro" } %>
              <% else %>
                <%= form.radio_button campo, valor, required: true, class: "peer sr-only", data: { action: "change->quiz#limparErro" } %>
              <% end %>
              <span class="block h-full rounded-xl border border-[#D9DADD] px-4 py-4 text-sm text-[#485057] hover:bg-[#F7F7F5] peer-checked:border-[#485057] peer-checked:bg-[#485057] peer-checked:text-white peer-focus-visible:ring-2 peer-focus-visible:ring-[#748A9C] peer-focus-visible:ring-offset-2"><%= rotulo %></span>
            </label>
          <% end %>
        </div>
      </fieldset>
    <% end %>
    <p data-quiz-target="erro" role="alert" class="text-sm text-red-700 mb-4"></p>
    <div class="flex items-center justify-between gap-3 border-t border-[#E5E6E7] pt-6">
      <button hidden type="button" data-quiz-target="anterior" data-action="quiz#anterior" class="rounded-full border border-[#D9DADD] px-5 py-3 text-sm text-[#485057]">Voltar</button>
      <button hidden type="button" data-quiz-target="proximo" data-action="quiz#proximo" class="ml-auto rounded-full bg-[#485057] px-6 py-3 text-sm text-white">Continuar →</button>
      <%= form.submit "Descobrir minhas sugestões", class: "ml-auto cursor-pointer rounded-full bg-[#485057] px-6 py-3 text-sm text-white", data: { quiz_target: "enviar", turbo_submits_with: "Buscando suas fragrâncias…" } %>
    </div>
  <% end %>
  <p class="text-center text-xs text-[#748A9C] mt-5">As sugestões dependem do cadastro e do estoque atual. Sua experiência com o perfume pode variar.</p>
</section>
