<section class="mt-6 rounded-xl border bg-white p-6 space-y-4">
  <h2 class="font-semibold text-lg">Entrega e cancelamento</h2>
  <% if pedido.pagamento_requer_atencao? %>
    <p class="text-red-700">Pagamento exige conferência no Mercado Pago: houve aprovação após cancelamento, estorno ou contestação. Confira a cobrança e o estoque antes de atender o cliente.</p>
  <% end %>
  <% if pedido.pendente? && !pedido.cobranca_online? %>
    <%= form_with url: confirmar_pagamento_admin_pedido_path(pedido), class: "space-y-3" do %>
      <label class="block"><%= check_box_tag :recebimento_confirmado, "1", false, required: true %> Conferi e recebi o valor integral por fora do checkout online.</label>
      <%= submit_tag "Confirmar recebimento manual", class: "rounded border px-4 py-2" %>
    <% end %>
  <% end %>
  <% if pedido.pago? || pedido.enviado? %>
    <%= form_with url: admin_pedido_path(pedido), method: :patch, scope: :pedido, class: "space-y-3" do |f| %>
      <%= f.label :status, "Situação" %>
      <%= f.select :status, (pedido.pago? ? [["Pago", "pago"], ["Enviado", "enviado"]] : [["Enviado", "enviado"], ["Entregue", "entregue"]]), selected: pedido.status %>
      <div><%= f.label :transportadora, "Transportadora ou responsável pela entrega local" %><%= f.text_field :transportadora, value: pedido.transportadora, maxlength: 150, class: "block w-full rounded border p-2" %></div>
      <div><%= f.label :codigo_rastreio, "Código de rastreamento (quando houver)" %><%= f.text_field :codigo_rastreio, value: pedido.codigo_rastreio, maxlength: 150, class: "block w-full rounded border p-2" %></div>
      <div><%= f.label :prazo_entrega, "Previsão de entrega" %><%= f.date_field :prazo_entrega, value: pedido.prazo_entrega %></div>
      <%= f.submit "Salvar entrega", class: "rounded bg-[#485057] px-4 py-2 text-white" %>
    <% end %>
  <% end %>
  <% unless pedido.cancelado? || pedido.entregue? %>
    <%= form_with url: cancelar_admin_pedido_path(pedido), class: "space-y-3" do %>
      <% if pedido.pendente? && pedido.cobranca_online? %>
        <label class="block"><%= check_box_tag :cobranca_encerrada, "1", false, required: true %> Conferi e encerrei a cobrança no Mercado Pago, sem pagamento em processamento.</label>
      <% end %>
      <% if pedido.pago? || pedido.enviado? %>
        <label class="block"><%= check_box_tag :reembolso_confirmado, "1", false, required: true %> Confirmei o reembolso no provedor e os produtos estão disponíveis para voltar ao estoque.</label>
      <% end %>
      <%= submit_tag "Cancelar pedido e devolver estoque", class: "rounded border border-red-300 px-4 py-2 text-red-700", data: { turbo_confirm: "Confirmar cancelamento e devolução do estoque?" } %>
    <% end %>
  <% end %>
  <% if pedido.cancelado? %><p><%= pedido.cancelamento_motivo %></p><% end %>
</section>
