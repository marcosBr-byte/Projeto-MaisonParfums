<section id="videos-home" class="mb-8 rounded-2xl border border-[#E5E6E7] bg-white p-6 shadow-sm" aria-labelledby="videos-home-titulo">
  <h2 id="videos-home-titulo" class="text-xl font-semibold text-[#343A40]">Vídeos do carrossel</h2>
  <p class="mt-2 mb-6 text-sm text-gray-500">Adicione, substitua, desative ou remova vídeos. Aceita MP4 ou WebM de até 100 MB e 2 minutos. Os vídeos são convertidos automaticamente para MP4 de até 720 × 1280 px, com compressão e carregamento progressivo. Só aparecem na loja após o processamento. A ordem menor aparece primeiro. Desative para guardar sem exibir.</p>
  <% @videos_home.each do |video| %>
    <article class="mb-6 rounded-xl border border-gray-200 p-4">
      <h3 class="mb-3 font-semibold"><%= video.titulo %></h3>
      <% unless video.pronto_para_exibir? %><p role="status" class="mb-3 text-sm text-gray-500"><%= video.arquivo.attached? && video.arquivo.blob.metadata["maison_video_falhou"] ? "Não foi possível otimizar. Envie outro MP4 ou WebM válido de até 2 minutos." : "Vídeo aguardando otimização. Ainda não aparece na loja." %></p><% end %>
      <%= video_tag(video.arquivo.attached? ? url_for(video.arquivo) : video.arquivo_padrao, controls: true, playsinline: true, preload: "none", class: "mb-4 h-48 w-full rounded-lg bg-black object-contain") %>
      <%= render "admin/customizar/video_form", video: video %>
      <%= button_to "Remover vídeo", admin_videos_home_path(video), method: :delete, class: "mt-4 rounded-lg border border-red-300 px-4 py-2 text-sm text-red-700", form: { data: { turbo_confirm: "Remover este vídeo do carrossel?" } } %>
    </article>
  <% end %>
  <% if @videos_home.empty? %>
    <p class="mb-4 text-sm text-gray-500">Nenhum vídeo cadastrado. O carrossel fica oculto até adicionar um vídeo ativo.</p>
  <% end %>
  <div class="rounded-xl bg-[#F7F7F5] p-4">
    <h3 class="mb-4 font-semibold">Adicionar vídeo</h3>
    <%= render "admin/customizar/video_form", video: @novo_video %>
  </div>
</section>
