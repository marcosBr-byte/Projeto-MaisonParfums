<div class="max-w-xl mx-auto px-4 py-10">
  <%= link_to "← Voltar ao painel", admin_path, class: "text-sm text-stone-600 hover:text-marinho" %>
  <h1 class="font-serif text-3xl text-marinho my-6">Perfil do administrador</h1>

  <dl class="divide-y divide-stone-200 border border-stone-200">
    <div class="flex justify-between px-4 py-3">
      <dt class="text-stone-600">Nome</dt>
      <dd><%= @usuario.nome %></dd>
    </div>

    <div class="flex justify-between px-4 py-3">
      <dt class="text-stone-600">E-mail</dt>
      <dd><%= @usuario.email %></dd>
    </div>

    <div class="flex justify-between px-4 py-3">
      <dt class="text-stone-600">Telefone</dt>
      <dd><%= @usuario.telefone %></dd>
    </div>

    <div class="flex justify-between px-4 py-3">
      <dt class="text-stone-600">Membro desde</dt>
      <dd><%= @usuario.created_at.strftime("%d/%m/%Y") %></dd>
    </div>
  </dl>

      
  <div class="flex justify-between px-4 py-3">
      <dt class="text-stone-600">Estado</dt>
      <dd><%= @usuario.estado.presence || "Não informado" %></dd>
  </div>

  <div class="flex justify-between px-4 py-3">
    <dt class="text-stone-600">Cidade</dt>
    <dd><%= @usuario.cidade.presence || "Não informado" %></dd>
  </div>

  <div class="flex justify-between px-4 py-3">
      <dt class="text-stone-600">Bairro</dt>
      <dd><%= @usuario.bairro.presence || "Não informado" %></dd>
  </div>

  <div class="mt-6">
    <%= link_to "Editar conta", edit_usuario_registration_path, class: "inline-block mt-7 px-6 py-3 rounded-full bg-[#485057] text-white text-sm hover:bg-[#748A9C] transition duration-300" %>
  </div>
</div>