<% content_for :title, "Meu perfil · Maison Parfum" %>
<div class="account-page">
  <nav class="account-breadcrumb" aria-label="Navegação estrutural">
    <%= link_to "Painel", admin_path %><span aria-hidden="true">/</span><span aria-current="page">Meu perfil</span>
  </nav>
  <header class="account-heading">
    <div><p class="account-eyebrow">Sua conta</p><h1>Meu perfil</h1><p>Um espaço para cuidar dos seus dados e do seu acesso à Maison.</p></div>
    <%= link_to edit_usuario_registration_path, class: "account-button account-button--primary" do %>
      <span class="material-symbols-outlined" aria-hidden="true">edit</span> Editar meus dados
    <% end %>
  </header>

  <div class="account-layout">
    <aside class="account-sidebar" aria-label="Resumo da conta">
      <%= render "shared/profile_identity", usuario: @usuario %>
      <div class="account-note"><span class="material-symbols-outlined" aria-hidden="true">manage_accounts</span><p>Seus dados de perfil são pessoais. Os contatos públicos da loja ficam em <%= link_to "Configurações", admin_configuracoes_path %>.</p></div>
    </aside>
    <div class="account-panels">
      <section class="account-card" aria-labelledby="dados-conta">
        <div class="account-card-heading"><span class="account-section-icon material-symbols-outlined" aria-hidden="true">person</span><div><h2 id="dados-conta">Dados pessoais</h2><p>As informações que identificam sua conta.</p></div></div>
        <dl class="account-data">
          <% [["Nome completo", @usuario.nome], ["E-mail de acesso", @usuario.email], ["Telefone com DDD", @usuario.telefone]].each do |rotulo, valor| %>
            <div><dt><%= rotulo %></dt><dd class="<%= 'account-empty' if valor.blank? %>"><%= valor.presence || "Não informado" %></dd></div>
          <% end %>
        </dl>
        <div class="account-card-bottom"><span>Precisa atualizar seu telefone ou e-mail?</span><%= link_to "Alterar dados →", edit_usuario_registration_path(anchor: "dados-pessoais") %></div>
      </section>

      <% if Usuario.omniauth_providers.any? %>
        <section class="account-card" aria-labelledby="contas-conectadas">
          <div class="account-card-heading"><span class="account-section-icon material-symbols-outlined" aria-hidden="true">link</span><div><h2 id="contas-conectadas">Contas conectadas</h2><p>Outra forma de acessar sua conta na loja.</p></div></div>
          <div class="account-social"><%= render "devise/shared/social_login", conectar: true %></div>
        </section>
      <% end %>
    </div>
  </div>
</div>
