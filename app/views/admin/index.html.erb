<div class="flex items-baseline justify-between mb-6">
  <h1 class="font-serif text-2xl text-stone-900">Painel Administrativo</h1>
  <span class="text-sm text-stone-500">Visão geral</span>
</div>

<div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-8">
  <% [["Usuários", @total_usuarios], ["Produtos", @total_produtos], ["Pedidos", @total_pedidos]].each do |titulo, total| %>
    <div class="rounded-xl border border-stone-200 bg-white p-5">
      <p class="text-sm text-stone-500"><%= titulo %></p>
      <p class="mt-1 text-3xl font-semibold text-stone-900"><%= total || 0 %></p>
    </div>
  <% end %>
</div>

<div class="rounded-xl border border-stone-200 bg-white overflow-hidden">
  <div class="flex items-center justify-between px-5 py-4 border-b border-stone-200">
    <h2 class="font-medium">Últimos pedidos</h2>
    <%= link_to "Ver todos", admin_pedidos_path, class: "text-sm text-stone-600 hover:text-stone-900" %>
  </div>
  <table class="w-full text-sm">
    <thead class="bg-stone-50 text-left text-stone-500">
      <tr>
        <th class="px-5 py-2">Usuário</th>
        <th class="px-5 py-2">Data</th>
        <th class="px-5 py-2">Status</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-stone-100">
      <% Array(@ultimos_pedidos).each do |pedido| %>
        <tr>
          <td class="px-5 py-3"><%= pedido.usuario&.email || "—" %></td>
          <td class="px-5 py-3"><%= pedido.created_at.strftime("%d/%m/%Y %H:%M") %></td>
          <td class="px-5 py-3">
            <span class="rounded-full bg-stone-100 px-2 py-0.5 text-xs text-stone-700">
              <%= pedido.status.to_s.titleize %>
            </span>
          </td>
        </tr>
      <% end %>
      <% if @ultimos_pedidos.blank? %>
        <tr>
          <td colspan="3" class="px-5 py-6 text-center text-stone-400">Nenhum pedido recente.</td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>