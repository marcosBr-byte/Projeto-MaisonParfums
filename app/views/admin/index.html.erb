<div class="admin-overview max-w-7xl mx-auto px-4 sm:px-8 py-8 space-y-6">
  <header class="admin-page-heading">
    <div><p class="admin-eyebrow">Visão geral</p><h1>Painel administrativo</h1><p>Acompanhe as vendas, organize os pedidos e cuide do seu catálogo.</p></div>
    <%= link_to new_produto_path, class: "admin-primary-action" do %><span class="material-symbols-outlined" aria-hidden="true">add</span> Cadastrar produto<% end %>
  </header>
  <%= render "admin/compartilhado/reposicao", reposicao: @reposicao %>
  <div class="grid sm:grid-cols-2 xl:grid-cols-4 gap-4">
    <%= render "admin/compartilhado/indicador", chave: "receita-mes", titulo: "Vendas confirmadas no mês", valor: moeda(@resumo.faturamento), icone: "payments", descricao: comparacao_vendas(@resumo.faturamento, @comparacao.faturamento) %>
    <%= render "admin/compartilhado/indicador", chave: "pedidos-mes", titulo: "Pedidos neste mês", valor: @resumo.total, icone: "shopping_bag", descricao: "#{@resumo.quantidade_confirmada} pagos, enviados ou entregues" %>
    <%= render "admin/compartilhado/indicador", chave: "ticket-mes", titulo: "Ticket médio confirmado", valor: moeda(@resumo.ticket_medio), icone: "receipt_long", descricao: "Valor médio dos pedidos confirmados neste mês" %>
    <%= render "admin/compartilhado/indicador", chave: "pendentes", titulo: "Pedidos para acompanhar", valor: @pedidos_pendentes, icone: "pending_actions", descricao: "Pedidos pendentes em toda a loja" %>
  </div>
  <div class="grid sm:grid-cols-3 gap-4">
    <% [[admin_pedidos_path(status: "pendente"), "pending_actions", "#{@pedidos_pendentes} pedidos pendentes", "Abrir fila de pedidos"], [admin_path(anchor: "reposicao"), "inventory_2", "#{@estoque_baixo} tamanhos com estoque baixo", "Confira tamanhos com menos de 5 unidades"], [admin_mensagens_path, "chat_bubble", "#{@mensagens_nao_lidas} mensagens não lidas", "Acompanhar atendimento"]].each do |caminho, icone, titulo, texto| %>
      <%= link_to caminho, class: "insight-action" do %><span class="material-symbols-outlined text-[#A07A43]" aria-hidden="true"><%= icone %></span><div><p class="text-sm font-semibold"><%= titulo %></p><p class="mt-1 text-xs text-[#748A9C]"><%= texto %> →</p></div><% end %>
    <% end %>
  </div>
  <div class="grid xl:grid-cols-3 gap-6">
    <div class="xl:col-span-3"><%= render "admin/compartilhado/evolucao", titulo: "Movimento dos últimos 7 dias", evolucao: @evolucao %></div>
  </div>
  <%= render "admin/compartilhado/pedidos", titulo: "Últimos pedidos da loja", descricao: "Abra um pedido para consultar seus detalhes.", pedidos: @ultimos_pedidos %>
  <div class="insight-footer-strip"><span><strong><%= @total_produtos %></strong> perfumes no catálogo</span><span><strong><%= @total_usuarios %></strong> contas cadastradas</span><span>Comparação mensal até o mesmo dia do mês anterior.</span></div>
</div>
