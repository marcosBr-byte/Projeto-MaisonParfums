<div class="p-8">
  <div class="mb-8">
    <h1 class="font-serif text-3xl text-[#343A40]"> Análise da loja</h1>
    <p class="mt-2 text-sm text-[#748A9C]"> Acompanhe diariamente os resultados da Maison Parfum.
    </p>
  </div>

  <div class="rounded-xl border border-[#E5E6E7] bg-white p-6">
    <div class="mb-6 flex items-center justify-between">

      <%= link_to admin_analisar_path( mes: @mes.prev_month.strftime("%Y-%m"), data: @data_selecionada.iso8601), class: "rounded-lg p-2 hover:bg-[#F0F1F2]" do %> <span class="material-symbols-outlined">chevron_left</span>
      <% end %>
      <h2 class="font-serif text-xl text-[#343A40]">
        <%= I18n.l(@mes, format: "%B de %Y").capitalize %>
      </h2>
      <%= link_to admin_analisar_path( mes: @mes.next_month.strftime("%Y-%m"), data: @data_selecionada.iso8601 ), class: "rounded-lg p-2 hover:bg-[#F0F1F2]" do %>
        <span class="material-symbols-outlined">chevron_right</span>
      <% end %>
    </div>

    <div class="grid grid-cols-7 gap-2 text-center">

      <% %w[Dom Seg Ter Qua Qui Sex Sáb].each do |dia| %>
        <div class="py-2 text-xs font-semibold text-[#748A9C]">
          <%= dia %>
        </div>
      <% end %>

      <% @dias_calendario.each do |dia| %>
        <% quantidade = @pedidos_por_dia[dia] || 0 %>
        <% selecionado = dia == @data_selecionada %>
        <% outro_mes = dia.month != @mes.month %>

        <%= link_to admin_analisar_path(data: dia.iso8601, mes: @mes.strftime("%Y-%m") ), class: "flex min-h-16 flex-col items-center justify-center rounded-xl border transition #{selecionado ? 'border-[#485057] bg-[#485057] text-white' : outro_mes ? 'border-transparent text-gray-300' : 'border-transparent text-[#485057] hover:bg-[#F0F1F2]'}" do %>
          <span class="text-sm font-medium"> <%= dia.day %> </span>
          <% if quantidade > 0 %> 
          <span class="mt-1 h-1.5 w-1.5 rounded-full <%= selecionado ? 'bg-white' : 'bg-[#748A9C]' %>"></span>
          <% end %>
        <% end %>
      <% end %>
    </div>

    <div class="mt-5 flex items-center gap-2 text-xs text-gray-500">
      <span class="h-2 w-2 rounded-full bg-[#748A9C]"></span>
       Dias com pedidos
    </div>

  </div>

  <div class="mb-6 mt-8">
    <h2 class="text-xl font-semibold text-[#343A40]"> Resultado de <%= l(@data_selecionada, format: "%d de %B de %Y") %></h2>
  </div>

  <div class="grid gap-5 sm:grid-cols-2 xl:grid-cols-3">

    <div class="rounded-xl border border-[#E5E6E7] bg-white p-6">
      <p class="text-sm text-gray-500">Faturamento</p>
      <p class="mt-3 text-2xl font-semibold text-[#343A40]"> <%= number_to_currency(@faturamento, unit: "R$ ", separator: ",", delimiter: ".") %>
      </p>
    </div>

    <div class="rounded-xl border border-[#E5E6E7] bg-white p-6">
      <p class="text-sm text-gray-500">Total de pedidos</p>
      <p class="mt-3 text-2xl font-semibold text-[#343A40]"> <%= @total_pedidos %> </p>
    </div>

    <div class="rounded-xl border border-[#E5E6E7] bg-white p-6">
      <p class="text-sm text-gray-500">Pedidos pagos</p>
      <p class="mt-3 text-2xl font-semibold text-[#343A40]"> <%= @pedidos_pagos %>
      </p>
    </div>

    <div class="rounded-xl border border-[#E5E6E7] bg-white p-6">
      <p class="text-sm text-gray-500">Pedidos pendentes</p>
      <p class="mt-3 text-2xl font-semibold text-[#343A40]"> <%= @pedidos_pendentes %> </p>
    </div>

    <div class="rounded-xl border border-[#E5E6E7] bg-white p-6">
      <p class="text-sm text-gray-500">Pedidos entregues</p>
      <p class="mt-3 text-2xl font-semibold text-[#343A40]"> <%= @pedidos_entregues %> </p>
    </div>

    <div class="rounded-xl border border-[#E5E6E7] bg-white p-6">
      <p class="text-sm text-gray-500">Pedidos cancelados</p>
      <p class="mt-3 text-2xl font-semibold text-[#343A40]"> <%= @pedidos_cancelados %> </p>
    </div>

  </div>

  <div class="mt-8 overflow-hidden rounded-xl border border-[#E5E6E7] bg-white">
    <div class="border-b border-[#E5E6E7] p-6">
      <h2 class="text-lg font-semibold text-[#343A40]"> Pedidos do dia </h2>
    </div>

    <% if @ultimos_pedidos.any? %>
      <div class="overflow-x-auto">
        <table class="w-full text-left text-sm">
          <thead class="bg-[#F7F7F5] text-[#485057]">
            <tr>
              <th class="p-4">Pedido</th>
              <th class="p-4">Cliente</th>
              <th class="p-4">Valor</th>
              <th class="p-4">Status</th>
            </tr>
          </thead>

          <tbody>
            <% @ultimos_pedidos.each do |pedido| %>
              <tr class="border-t border-[#E5E6E7]">
                <td class="p-4">#<%= pedido.id %></td>
                <td class="p-4"><%= pedido.usuario.email %></td>
                <td class="p-4">
                  <%= number_to_currency(pedido.valor_total, unit: "R$ ", separator: ",", delimiter: ".") %>
                </td>
                <td class="p-4"><%= pedido.status.humanize %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <p class="p-8 text-center text-sm text-gray-500">
        Nenhum pedido encontrado nesta data.
      </p>
    <% end %>
  </div>
</div>