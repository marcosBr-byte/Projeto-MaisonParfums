<div class="p-6 md:p-8">
  <%= link_to admin_path, class: "inline-flex items-center gap-2 text-sm text-stone-500 transition hover:text-amber-700" do %>
    <span>←</span>
    <span>Voltar ao painel</span>
  <% end %>
  <div class="mb-8 mt-6 flex flex-col justify-between gap-5 sm:flex-row sm:items-end">
    <div>
      <p class="mb-2 text-xs uppercase tracking-[0.3em] text-[#748A9C]">Maison Parfum</p>
      <h1 class="font-serif text-3xl text-[#485057] md:text-4xl">Mensagens</h1>
      <p class="mt-3 text-sm text-stone-500">Gerencie as mensagens enviadas pelos clientes.</p>
    </div>

    <div class="rounded-xl border border-[#E5E6E7] bg-white px-5 py-4">
      <p class="text-xs text-stone-500">Mensagens não lidas</p>
      <p class="mt-1 text-2xl font-semibold text-[#485057]">
        <%= @nao_lidas %>
      </p>
    </div>
  </div>

  <% if @mensagens.any? %>
    <div class="overflow-hidden rounded-2xl border border-[#E5E6E7] bg-white shadow-sm">
      <div class="overflow-x-auto">
        <table class="w-full text-left">

          <thead class="border-b border-[#E5E6E7] bg-[#F7F7F5]">
            <tr>
              <th class="px-6 py-4 text-xs font-semibold uppercase tracking-wider text-stone-500">
                Cliente
              </th>

              <th class="px-6 py-4 text-xs font-semibold uppercase tracking-wider text-stone-500">
                Assunto
              </th>

              <th class="px-6 py-4 text-xs font-semibold uppercase tracking-wider text-stone-500">
                E-mail
              </th>

              <th class="px-6 py-4 text-xs font-semibold uppercase tracking-wider text-stone-500">
                Recebida em
              </th>

              <th class="px-6 py-4 text-xs font-semibold uppercase tracking-wider text-stone-500">Status </th>
              <th class="px-6 py-4 text-right text-xs font-semibold uppercase tracking-wider text-stone-500">Ação</th></tr>
          </thead>

          <tbody class="divide-y divide-stone-100">
            <% @mensagens.each do |mensagem| %>
              <tr class="transition hover:bg-stone-50">
                <td class="px-6 py-4">
                  <p class="font-medium text-[#485057]">
                    <%= mensagem.nome %>
                  </p>
                </td>
                <td class="px-6 py-4">
                  <p class="text-sm text-stone-700">
                    <%= mensagem.assunto %>
                  </p>
                </td>
                <td class="px-6 py-4">
                  <p class="text-sm text-stone-500">
                    <%= mensagem.email %>
                  </p>
                </td>
                <td class="px-6 py-4 text-sm text-stone-500">
                  <%= mensagem.created_at.strftime("%d/%m/%Y às %H:%M") %>
                </td>

                <td class="px-6 py-4">
                  <% if mensagem.lida? %>
                    <span class="inline-flex rounded-full bg-stone-100 px-3 py-1 text-xs font-medium text-stone-600">Lida</span>
                  <% else %>
                    <span class="inline-flex rounded-full bg-amber-50 px-3 py-1 text-xs font-medium text-amber-700">Não lida</span>
                  <% end %>
                </td>
                <td class="px-6 py-4 text-right">
                  <%= link_to "Visualizar", admin_mensagen_path(mensagem),class: "inline-flex items-center rounded-lg bg-[#485057] px-4 py-2 text-xs font-medium text-white transition hover:bg-[#748A9C]" %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  <% else %>
    <div class="rounded-2xl border border-dashed border-[#D0D3D6] bg-white px-6 py-16 text-center">
      <div class="mx-auto mb-4 flex h-14 w-14 items-center justify-center rounded-full bg-[#F7F7F5]">
        <span class="text-2xl">✉</span>
      </div>

      <h2 class="text-lg font-semibold text-[#485057]">Nenhuma mensagem recebida</h2>
      <p class="mt-2 text-sm text-stone-500">Quando os clientes enviarem mensagens, elas aparecerão aqui.</p>
    </div>
  <% end %>
</div>