<div class="p-6 md:p-8">
  <%= link_to admin_mensagens_path, class: "text-sm text-stone-500 hover:text-amber-700" do %>
    ← Voltar para mensagens
  <% end %>

  <h1 class="mt-5 text-2xl font-semibold text-stone-800">Detalhes da mensagem</h1>
  <p class="mt-1 text-sm text-stone-500"> Visualize a mensagem enviada pelo cliente.</p>
</div>

<div class="rounded-2xl border border-stone-200 bg-white p-6 md:p-8 shadow-sm">
  <div class="mb-6 border-b border-stone-100 pb-5">
    <p class="text-xs font-medium uppercase tracking-wider text-stone-400">Assunto</p>
    <h2 class="mt-2 text-lg font-semibold text-stone-800">
      <%= @mensagem.assunto %>
    </h2>
  </div>

  <div class="grid gap-5 sm:grid-cols-2">
    <div>
      <p class="text-xs font-medium uppercase tracking-wider text-stone-400">Remetente</p>
      <p class="mt-1 font-medium text-stone-700">
        <%= @mensagem.nome %>
      </p>
    </div>

    <div>
      <p class="text-xs font-medium uppercase tracking-wider text-stone-400"> E-mail</p>
      <p class="mt-1 text-stone-700">
        <%= @mensagem.email %>
      </p>
    </div>

    <div>
      <p class="text-xs font-medium uppercase tracking-wider text-stone-400">Recebida em</p>
      <p class="mt-1 text-stone-700">
        <%= @mensagem.created_at.strftime("%d/%m/%Y às %H:%M") %>
      </p>
    </div>

    <% if @mensagem.pedido.present? %>
      <div>
        <p class="text-xs font-medium uppercase tracking-wider text-stone-400">
          Pedido relacionado
        </p>
        <p class="mt-1 text-stone-700">
          #<%= @mensagem.pedido.id %>
        </p>
      </div>
    <% end %>
  </div>
  <div class="mt-8 border-t border-stone-100 pt-6">
    <p class="mb-3 text-xs font-medium uppercase tracking-wider text-stone-400">Mensagem</p>
    <div class="whitespace-pre-wrap rounded-xl bg-stone-50 p-5 leading-relaxed text-stone-700"><%= @mensagem.conteudo %></div>
  </div>
  <div class="mt-8 flex flex-wrap gap-3">
    <%= link_to "Responder por e-mail", "mailto:#{@mensagem.email}?subject=#{ERB::Util.url_encode("Re: #{@mensagem.assunto}")}",class: "rounded-xl bg-stone-800 px-5 py-3 text-sm font-medium text-white hover:bg-stone-700" %>
    <%= button_to "Excluir mensagem",admin_mensagen_path(@mensagem), method: :delete, form: { data: { turbo_confirm: "Tem certeza que deseja excluir esta mensagem?" } },class: "rounded-xl border border-red-200 px-5 py-3 text-sm font-medium text-red-600 hover:bg-red-50" %>
  </div>
</div>