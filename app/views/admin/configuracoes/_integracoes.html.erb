<% campo = "w-full rounded-lg border border-[#D0D3D6] p-3 text-sm" %>
<% rotulo = "mb-2 block text-sm font-medium text-[#485057]" %>
<% url_webhook = configuracao.url_pagamento_valida? ? "#{configuracao.pagamento_site_url.delete_suffix('/')}#{mercado_pago_webhook_path}" : mercado_pago_webhook_url %>

<section class="rounded-xl border border-[#E5E6E7] bg-white p-6 shadow-sm space-y-4" aria-labelledby="mercado-pago-titulo">
  <div>
    <h2 id="mercado-pago-titulo" class="text-lg font-semibold text-[#343A40]">Receber Pix e cartão — Mercado Pago</h2>
    <p class="mt-1 text-sm text-gray-500"><%= configuracao.pagamento_configurado? ? "Checkout habilitado em #{configuracao.pagamento_teste? ? 'modo de teste' : 'produção'}." : "Checkout online indisponível. Complete a configuração para habilitar." %></p>
  </div>
  <label class="flex gap-3 items-center text-sm"><%= f.check_box :pagamento_ativo %> Ativar o checkout do Mercado Pago</label>
  <label class="flex gap-3 items-center text-sm"><%= f.check_box :pagamento_teste %> Usar o ambiente de teste</label>
  <div>
    <%= f.label :pagamento_site_url, "Endereço HTTPS da loja", class: rotulo %>
    <%= f.url_field :pagamento_site_url, placeholder: request.base_url, class: campo %>
  </div>
  <div>
    <%= f.label :pagamento_token, "Access Token do Mercado Pago", class: rotulo %>
    <%= f.password_field :pagamento_token, value: "", autocomplete: "new-password", class: campo,
      placeholder: configuracao.pagamento_token.present? ? "Cadastrado" : nil %>
  </div>
  <div>
    <%= f.label :pagamento_webhook_secret, "Chave de assinatura do webhook", class: rotulo %>
    <%= f.password_field :pagamento_webhook_secret, value: "", autocomplete: "new-password", class: campo,
      placeholder: configuracao.pagamento_webhook_secret.present? ? "Cadastrada" : nil %>
    <p class="mt-1 text-xs text-gray-500">Campos de credenciais em branco preservam os valores cadastrados. As variáveis do servidor têm prioridade.</p>
  </div>
  <div>
    <label for="mercado-pago-webhook" class="<%= rotulo %>">URL para notificações do Mercado Pago</label>
    <%= text_field_tag nil, url_webhook, id: "mercado-pago-webhook", readonly: true, class: campo %>
  </div>
</section>

<section class="rounded-xl border border-[#E5E6E7] bg-white p-6 shadow-sm space-y-4" aria-labelledby="whatsapp-pedidos-titulo">
  <div>
    <h2 id="whatsapp-pedidos-titulo" class="text-lg font-semibold text-[#343A40]">Avisos de pedidos no WhatsApp</h2>
    <p class="mt-1 text-sm text-gray-500">A loja recebe o número e o total do pedido após a confirmação de um pagamento real.</p>
  </div>
  <label class="flex gap-3 items-center text-sm"><%= f.check_box :whatsapp_notificacoes_ativas %> Avisar quando um pedido for pago</label>
  <div>
    <%= f.label :whatsapp_notificacao, "WhatsApp que recebe os avisos", class: rotulo %>
    <%= f.telephone_field :whatsapp_notificacao, placeholder: "Ex.: 5583999999999", class: campo %>
    <p class="mt-1 text-xs text-gray-500"><%= WhatsAppPedido.configurado? ? "Configuração da Meta encontrada no servidor." : "Cadastre no Render as credenciais da Meta e o modelo de mensagem aprovado antes de ativar." %></p>
  </div>
</section>
