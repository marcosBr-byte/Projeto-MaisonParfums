<div class="p-6 md:p-8">
  <div class="mb-8">
    <h1 class="text-3xl font-serif text-[#343A40]">Configurações</h1>
    <p class="mt-2 text-sm text-[#748A9C]">Gerencie as informações e os canais de atendimento da Maison Parfum.</p>
  </div>

  <%= form_with model: @configuracao, url: admin_configuracoes_path, method: :patch,  class: "space-y-6" do |f| %>
    <% if @configuracao.errors.any? %>
      <div class="rounded-xl border border-red-200 bg-red-50 p-4 text-sm text-red-700">
        <p class="font-semibold mb-2">Não foi possível salvar as configurações:</p>
        <ul class="list-disc pl-5">
          <% @configuracao.errors.full_messages.each do |mensagem| %>
            <li><%= mensagem %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="rounded-xl border border-[#E5E6E7] bg-white p-6 shadow-sm">
      <h2 class="text-lg font-semibold text-[#343A40]">Informações da loja</h2>
      <p class="mt-1 mb-5 text-sm text-gray-500">Apresente a Maison Parfum aos seus clientes.</p>
      <div>
        <%= f.label :descricao, "Descrição da loja", class: "mb-2 block text-sm font-medium text-[#485057]" %>
        <%= f.rich_text_area :descricao, class: "trix-content" %>
      </div>
    </div>

    <div class="rounded-xl border border-[#E5E6E7] bg-white p-6 shadow-sm">
      <h2 class="text-lg font-semibold text-[#343A40]">Canais de atendimento</h2>
      <p class="mt-1 mb-5 text-sm text-gray-500">Informe como seus clientes podem entrar em contato. </p>

      <div class="space-y-5">
        <div>
          <%= f.label :whatsapp, "WhatsApp", class: "mb-2 block text-sm font-medium text-[#485057]" %>
          <%= f.telephone_field :whatsapp, placeholder: "Ex.: 5583999999999", class: "w-full rounded-lg border border-[#D0D3D6] p-3 text-sm focus:border-[#748A9C] focus:outline-none focus:ring-1 focus:ring-[#748A9C]" %>
          <p class="mt-1 text-xs text-gray-400">Digite o número com código do país e DDD.</p>
        </div>

        <div>
          <%= f.label :email_contato, "E-mail de contato",class: "mb-2 block text-sm font-medium text-[#485057]" %>
          <%= f.email_field :email_contato, placeholder: "contato@maisonparfum.com", class: "w-full rounded-lg border border-[#D0D3D6] p-3 text-sm focus:border-[#748A9C] focus:outline-none focus:ring-1 focus:ring-[#748A9C]" %>
        </div>
      </div>
    </div>

    <div class="rounded-xl border border-[#E5E6E7] bg-white p-6 shadow-sm">
      <h2 class="text-lg font-semibold text-[#343A40]">Redes sociais </h2>
      <p class="mt-1 mb-5 text-sm text-gray-500">Adicione o endereço do Instagram da loja.</p>
      <div>
        <%= f.label :instagram_url, "Instagram", class: "mb-2 block text-sm font-medium text-[#485057]" %>
        <%= f.url_field :instagram_url,  placeholder: "https://www.instagram.com/sua_loja", class: "w-full rounded-lg border border-[#D0D3D6] p-3 text-sm focus:border-[#748A9C] focus:outline-none focus:ring-1 focus:ring-[#748A9C]" %>
      </div>
    </div>
    <section class="rounded-xl border border-[#E5E6E7] bg-white p-6 shadow-sm space-y-5">
      <h2 class="text-lg font-semibold text-[#343A40]">Promoções e brinde</h2>
      <div>
        <%= f.label :frete_pago_valor, "Frete fixo para pedidos sem frete grátis (R$)", class: "block mb-2" %>
        <%= f.number_field :frete_pago_valor, min: 0, step: 0.01, class: "w-full border rounded-lg p-3" %>
        <p class="text-xs mt-2">Esse valor será somado ao pagamento quando o pedido não atingir a campanha regional. Use 0 somente para isentar o frete.</p>
      </div>
      <label class="flex gap-3 items-center text-sm"><%= f.check_box :frete_gratis_ativo %> Oferecer frete grátis por valor do pedido</label>
      <div>
        <%= f.label :frete_gratis_meta, "Frete grátis — demais regiões (R$)", class: "block mb-2 text-sm font-medium" %>
        <%= f.number_field :frete_gratis_meta, min: 0.01, step: 0.01, class: "w-full rounded-lg border border-[#D0D3D6] p-3 text-sm" %>
        <p class="mt-2 text-xs text-gray-500">O caminhão no carrinho avança conforme o total após descontos. O benefício fica registrado no pedido.</p>
      </div>
      <div>
        <%= f.label :frete_gratis_meta_nordeste, "Frete grátis — Nordeste (R$)", class: "block mb-2 text-sm font-medium" %>
        <%= f.number_field :frete_gratis_meta_nordeste, min: 0.01, step: 0.01, class: "w-full rounded-lg border border-[#D0D3D6] p-3 text-sm" %>
        <p class="mt-2 text-xs text-gray-500">A região é definida pelo CEP e estado do endereço de entrega.</p>
      </div>
      <p class="text-sm text-gray-500">O desconto vale para todos os produtos e novos pedidos. Pedidos já registrados mantêm seus valores.</p>
      <label class="flex gap-3 items-center text-sm"><%= f.check_box :desconto_ativo %> Ativar desconto global</label>
      <div>
        <%= f.label :desconto_percentual, "Desconto em todos os produtos (%)", class: "block mb-2 text-sm font-medium" %>
        <%= f.number_field :desconto_percentual, min: 0, max: 100, step: 0.01, class: "w-full rounded-lg border border-[#D0D3D6] p-3 text-sm" %>
      </div>
      <label class="flex gap-3 items-center text-sm"><%= f.check_box :brinde_ativo %> Oferecer brinde por valor do pedido</label>
      <div>
        <%= f.label :brinde_meta, "Valor para ganhar brinde (R$)", class: "block mb-2 text-sm font-medium" %>
        <%= f.number_field :brinde_meta, min: 0.01, step: 0.01, class: "w-full rounded-lg border border-[#D0D3D6] p-3 text-sm" %>
        <p class="mt-2 text-xs text-gray-500">Calculado sobre os produtos após descontos, sem frete. Para a promoção da amostra, use o valor mínimo de R$ 199,99.</p>
      </div>
      <div>
        <%= f.label :brinde_descricao, "Descrição do brinde", class: "block mb-2 text-sm font-medium" %>
        <%= f.text_field :brinde_descricao, class: "w-full rounded-lg border border-[#D0D3D6] p-3 text-sm" %>
      </div>
      <div>
        <%= f.label :borrifadas_por_ml, "Estimativa de borrifadas por ml", class: "block mb-2 text-sm font-medium" %>
        <%= f.number_field :borrifadas_por_ml, min: 1, max: 1000, step: 1, class: "w-full rounded-lg border border-[#D0D3D6] p-3 text-sm" %>
        <p class="mt-2 text-xs text-gray-500">Ajuste conforme o borrifador utilizado. É uma estimativa, não uma medição exata.</p>
      </div>
    </section>

    <%= render "integracoes", f: f, configuracao: @configuracao %>

    <div class="flex justify-end">
      <%= f.submit "Salvar configurações", class: "cursor-pointer rounded-lg bg-[#485057] px-6 py-3 text-sm font-semibold text-white transition hover:bg-[#748A9C]" %>
    </div>
  <% end %>
</div>
