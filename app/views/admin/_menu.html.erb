<%
  ativo = ->(caminho) { request.path == caminho }

  principais = [
    ["Início", "grid_view", admin_path, ativo.call(admin_path)],
    ["Produtos", "inventory_2", produtos_path, ativo.call(produtos_path) || request.path.match?(%r{\A/produtos/\d+/edit})],
    ["Cadastrar produto", "add_circle", new_produto_path, ativo.call(new_produto_path)],
    ["Frascos mãe", "science", frasco_maes_path, request.path.start_with?("/frasco_maes")],
    ["Pedidos", "receipt_long", admin_pedidos_path, request.path.start_with?("/admin/pedidos")]
  ]

  adicionais = [
    ["Perfil", "person", admin_perfil_path],
    ["Customizar", "palette", admin_customizar_path],
    ["Analisar", "insights", admin_analisar_path],
    ["Mensagens", "mail", admin_mensagens_path],
    ["Configurações", "settings", admin_configuracoes_path]
  ]
%>

<aside class="fixed inset-y-0 left-0 z-50 flex w-64 -translate-x-full flex-col overflow-y-auto border-r border-[#E5E6E7] bg-white px-5 py-6 transition-transform duration-300 peer-checked:translate-x-0 md:translate-x-0">

  <div class="mb-10 flex items-center justify-between">
    <%= link_to admin_path, class: "font-serif text-2xl tracking-wide text-[#485057]" do %>
      Maison <span class="text-[#748A9C]">Parfum</span>
    <% end %>

    <label for="menu-admin" class="flex cursor-pointer items-center text-[#748A9C] md:hidden" aria-label="Fechar menu">
      <span class="material-symbols-outlined">close</span>
    </label>
  </div>

  <nav class="flex flex-1 flex-col gap-1">

    <% principais.each do |nome, icone, caminho, ativo_agora| %>
      <%= link_to caminho, class: "flex items-center gap-3 rounded-xl px-4 py-3 text-sm font-medium transition #{ativo_agora ? 'bg-[#485057] text-white' : 'text-[#485057] hover:bg-[#F0F1F2] hover:text-[#748A9C]'}" do %>
        <span class="material-symbols-outlined"><%= icone %></span>
        <span><%= nome %></span>
      <% end %>
    <% end %>

    <p class="mt-6 mb-1 px-4 text-xs uppercase tracking-widest text-[#B8BDC3]">
      Gerenciamento
    </p>

    <% adicionais.each do |nome, icone, caminho| %>
      <% ativo_agora = request.path == caminho %>

      <%= link_to caminho, class: "flex items-center gap-3 rounded-xl px-4 py-3 text-sm font-medium transition #{ativo_agora ? 'bg-[#485057] text-white' : 'text-[#485057] hover:bg-[#F0F1F2] hover:text-[#748A9C]'}" do %>
        <span class="material-symbols-outlined"><%= icone %></span>
        <span><%= nome %></span>
      <% end %>
    <% end %>

    <div class="mt-auto space-y-1 border-t border-[#E5E6E7] pt-4">
      <%= link_to root_path, class: "flex items-center gap-3 rounded-xl px-4 py-3 text-sm font-medium text-[#485057] transition hover:bg-[#F0F1F2] hover:text-[#748A9C]" do %>
        <span class="material-symbols-outlined">storefront</span>
        <span>Ver a loja</span>
      <% end %>

      <%= button_to destroy_usuario_session_path, method: :delete, form: { class: "w-full" },
          class: "flex w-full cursor-pointer items-center gap-3 rounded-xl px-4 py-3 text-sm font-medium text-red-600 transition hover:bg-red-50" do %>
        <span class="material-symbols-outlined">logout</span>
        <span>Sair</span>
      <% end %>
    </div>

  </nav>
</aside>