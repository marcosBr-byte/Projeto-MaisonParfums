<article class="insight-card" data-indicador="<%= chave %>">
  <div class="flex items-start justify-between gap-3"><p class="text-sm text-[#748A9C]"><%= titulo %></p><span class="material-symbols-outlined insight-icon" aria-hidden="true"><%= icone %></span></div>
  <p class="mt-3 text-2xl sm:text-3xl font-bold text-[#343A40] tabular-nums"><%= valor %></p>
  <p class="mt-3 text-xs leading-relaxed text-[#748A9C]"><%= descricao %></p>
</article>
