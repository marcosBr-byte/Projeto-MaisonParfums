<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8">
    <title><%= content_for(:title) || "Admin · Maison Parfum" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Quicksand:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined" rel="stylesheet">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="admin-shell bg-[#F7F7F5] text-[#485057]">
    <a href="#admin-content" class="admin-skip-link">Pular para o conteúdo</a>
    <input type="checkbox" id="menu-admin" class="peer sr-only" aria-label="Abrir menu">

    <%# Barra de topo (só no celular) %>
    <header class="md:hidden sticky top-0 z-30 flex items-center justify-between border-b border-[#E5E6E7] bg-white px-4 py-3">
      <label for="menu-admin" class="flex cursor-pointer items-center text-[#485057]" aria-label="Abrir menu">
        <span class="material-symbols-outlined">menu</span>
      </label>
      <span class="font-serif text-lg text-[#485057]">Maison Parfum</span>
      <span class="w-6"></span>
    </header>

    <%# Fundo escuro quando o menu abre no celular %>
    <label for="menu-admin" class="fixed inset-0 z-40 bg-black/40 opacity-0 pointer-events-none transition-opacity duration-300 peer-checked:opacity-100 peer-checked:pointer-events-auto md:hidden"></label>

    <%= render "admin/menu" %>

    <main id="admin-content" tabindex="-1" class="admin-content min-h-screen md:ml-64">
      <div class="admin-workspace-bar">
        <%= link_to root_path, class: "admin-store-link" do %>
          <span class="material-symbols-outlined" aria-hidden="true">open_in_new</span> Ver loja
        <% end %>
      </div>
      <%= render "shared/notifications" %>

      <%= yield %>
    </main>
  </body>
</html>
