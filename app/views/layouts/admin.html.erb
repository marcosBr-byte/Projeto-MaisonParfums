<!DOCTYPE html>
<html>
<head>
  <title>Maison Parfum · Admin</title>
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <%= csrf_meta_tags %>
  <%= stylesheet_link_tag "tailwind", "data-turbo-track:" "reload" %>
  <%= stylesheet_link_tag "tailwind", "data-turbo-track:" "reload" %>
  <%= javascript_importmap_tags %>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined">
</head>
<body class="bg-stone-100 text-stone-800">
  <div class="flex min-h-screen">
    <aside class="w-16 md:w-60 shrink-0 bg-white border-r border-stone-200 p-3 md:p-4">
      <h2 class="hidden md:block font-serif text-xl text-stone-900 mb-6">Maison Parfum</h2>
      <nav class="space-y-1">
        <% [["Início", "grid_view", admin_path],
            ["Customizar", "person", "#"],
            ["Pedidos", "receipt_long", admin_pedidos_path],
            ["Analisar", "insights", "#"],
            ["Mensagens", "mail", "#"],
            ["Produtos", "inventory_2", new_produto_path],
            ["Configuração", "settings", "#"]].each do |nome, icone, caminho| %>
          <%= link_to caminho, class: "flex items-center gap-3 rounded-lg px-3 py-2 text-stone-600 hover:bg-stone-100 #{'bg-stone-200 text-stone-900 font-medium' if current_page?(caminho)}" do %>
            <span class="material-symbols-outlined"><%= icone %></span>
            <span class="hidden md:inline"><%= nome %></span>
          <% end %>
        <% end %>
        <%= button_to destroy_usuario_session_path, method: :delete,
              class: "flex w-full items-center gap-3 rounded-lg px-3 py-2 text-stone-600 hover:bg-stone-100" do %>
          <span class="material-symbols-outlined">logout</span>
          <span class="hidden md:inline">Sair</span>
        <% end %>
      </nav>
    </aside>

    <main class="flex-1 p-6 md:p-8"><%= yield %></main>
  </div>
</body>
</html>