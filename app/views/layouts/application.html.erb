<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8">
    <title><%= content_for(:title) || "Maison Parfum" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Maison Parfum">
    <meta name="mobile-web-app-capable" content="yes">
    <link rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <%= render "shared/maison_icons" %>

    <%# Ícones do dashboard %>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Quicksand:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined" rel="stylesheet">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <% login_page = content_for?(:login_page) %>
  <body class="bg-[#F7F7F5]">

    <header class="bg-[#E5E6E7] border-b border-[#D0D3D6] shrink-0 <%= login_page ? "md:sticky md:top-0 md:z-50" : "sticky top-0 z-50" %>">
      <div class="max-w-7xl mx-auto px-4 py-2 flex items-center justify-between gap-6">
        <%= link_to root_path, class: "shrink-0 rounded-md" do %>
          <%= render "shared/maison_logo" %>
        <% end %>

        <%= render "shared/perfume_search", identificador: "busca-desktop", classes: "hidden md:flex flex-1 max-w-md" %>
        <div class="flex items-center gap-4 text-sm text-[#485057]">

          
      <% if usuario_signed_in? %>
        <% if current_usuario.admin? %>
          <%= link_to admin_perfil_path, aria: { label: "Meu perfil" }, title: "Meu perfil", class: "flex items-center hover:text-[#748A9C] transition-all duration-300 hover:scale-110" do %>
            <span class="material-symbols-outlined">person</span>
          <% end %>
        <% else %>
          <%= link_to perfil_path, aria: { label: "Meu perfil" }, title: "Meu perfil", class: "flex items-center hover:text-[#748A9C] transition-all duration-300 hover:scale-110" do %>
            <span class="material-symbols-outlined">person</span>
          <% end %>

          <%= link_to carrinho_path, aria: { label: "Meu carrinho" }, title: "Meu carrinho", class: "flex items-center hover:text-[#748A9C] transition-all duration-300 hover:scale-110" do %>
            <span class="material-symbols-outlined">shopping_cart</span>
          <% end %>

          <%= link_to new_mensagen_path, aria: { label: "Mensagens" }, title: "Mensagens", class: "flex items-center hover:text-[#748A9C] transition-all duration-300 hover:scale-110" do %>
            <span class="material-symbols-outlined">mail</span>
          <% end %>
        <% end %>

        <%= button_to destroy_usuario_session_path, method: :delete, aria: { label: "Sair" }, title: "Sair", class: "flex items-center hover:text-[#748A9C] cursor-pointer transition-all duration-300 hover:scale-110" do %>
          <span class="material-symbols-outlined">logout</span>
        <% end %>
      <% else %>
        <%= link_to new_usuario_session_path, aria: { label: "Entrar" }, title: "Entrar", class: "flex items-center hover:text-[#748A9C] transition-all duration-300 hover:scale-110" do %>
          <span class="material-symbols-outlined">person</span>
        <% end %>
      <% end %>
        </div>
      </div>

      <nav class="hidden md:block border-t border-[#D9DADD]">
        <ul class="max-w-7xl mx-auto px-4 flex flex-wrap justify-center items-center gap-x-6 text-sm font-medium text-[#485057]">
          <li class="py-3"><%= link_to "Início", root_path, class: "hover:text-[#748A9C] transition-colors duration-300" %></li>

          <% [
               ["Decantes Masculinos", :decants_masculinos_path, :origem, Produto::ORIGENS],
               ["Decantes Femininos", :decants_femininos_path, :origem, Produto::ORIGENS],
               ["Decantes Unissex", :decants_unissex_path, :origem, Produto::ORIGENS],
               ["Decantes Nicho", :decants_nicho_path, :origem, Produto::ORIGENS_NICHO],
               ["Body Splash", :body_splash_path, :publico, Produto::PUBLICOS],
               ["Hidratantes", :hidratantes_path, :publico, Produto::PUBLICOS]
             ].each do |titulo, rota, filtro, opcoes| %>
            <li class="relative group py-3">
              <%= link_to public_send(rota), class: "inline-flex items-center gap-1 hover:text-[#748A9C] transition-colors duration-300" do %>
                <%= titulo %>
                <span class="material-symbols-outlined text-base" aria-hidden="true">expand_more</span>
              <% end %>

              <ul class="invisible opacity-0 translate-y-2 pointer-events-none group-hover:visible group-hover:opacity-100 group-hover:translate-y-0 group-hover:pointer-events-auto group-focus-within:visible group-focus-within:opacity-100 group-focus-within:translate-y-0 group-focus-within:pointer-events-auto transition-all duration-300 ease-out absolute left-0 top-full pt-2 bg-white/95 backdrop-blur-md border border-[#D9DADD]/70 shadow-[0_10px_30px_rgba(72,80,87,0.18)] rounded-lg min-w-44 z-20">
                <% opcoes.each do |valor, nome| %>
                  <li>
                    <%= link_to nome, public_send(rota, filtro => valor), class: "block px-4 py-2 text-[#485057] hover:bg-[#F0F1F2] hover:pl-6 transition-all duration-300" %>
                  </li>
                <% end %>
              </ul>
            </li>
          <% end %>

          <li class="py-3"><%= link_to "Destaques", root_path(anchor: "selecao-maison"), class: "hover:text-[#748A9C] transition-colors duration-300" %></li>
          <li class="py-3"><%= link_to "Descubra seu Perfume", quiz_path, class: "hover:text-[#748A9C] transition-colors duration-300" %></li>
          <li class="py-3"><%= link_to "Contato", atendimento_path, class: "hover:text-[#748A9C] transition-colors duration-300" %></li>
          <li class="py-3"><%= link_to "Grupo VIP", grupo_vip_path, class: "hover:text-[#748A9C] transition-colors duration-300" %></li>
        </ul>
      </nav>

      <%= render "shared/mobile_navigation" unless login_page %>
    </header>

     <main>
      <%= render "shared/notifications" unless login_page %>
      <%= yield %>
    </main>

    
    <% configuracao_loja = Configuracao.atual %>
    <footer id="contato" class="bg-[#E5E6E7] border-t border-[#D0D3D6] text-[#485057]">
      <div class="max-w-7xl mx-auto px-6 py-12">
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-10">
          <div>
            <%= link_to root_path, class: "inline-block rounded-md" do %>
              <%= render "shared/maison_logo", classe: "maison-logo--full" %>
            <% end %>
            <div class="trix-content text-sm text-[#737980] leading-relaxed mt-4 max-w-xs">
              <%= configuracao_loja.descricao.presence ||
                  "Descubra novas fragrâncias e encontre o perfume que combina com você." %>
            </div>
          </div>
          <div>
            <h3 class="font-semibold text-base mb-5">Menu principal</h3>
            <ul class="space-y-3 text-sm text-[#737980]">
              <li>
                <%= link_to "Início", root_path, class: "hover:text-[#485057] transition" %>
              </li>
              <li>
                <%= link_to "Decantes masculinos", decants_masculinos_path, class: "hover:text-[#485057] transition" %>
              </li>
              <li>
                <%= link_to "Decantes femininos", decants_femininos_path, class: "hover:text-[#485057] transition" %>
              </li>
              <li>
                <%= link_to "Minha conta", new_usuario_session_path, class: "hover:text-[#485057] transition" %>
              </li>
            </ul>
          </div>
          <div>
            <h3 class="font-semibold text-base mb-5">Informações</h3>

            <ul class="space-y-3 text-sm text-[#737980]">
              <li>
                <%= link_to "Perguntas frequentes", perguntas_frequentes_path, class: "hover:text-[#485057] transition" %>
              </li>

              <li>
                <%= link_to "Trocas e devoluções", trocas_path, class: "hover:text-[#485057] transition" %>
              </li>

              <li>
                <%= link_to "Política de privacidade", privacidade_path, class: "hover:text-[#485057] transition" %>
              </li>

              <li>
                <%= link_to "Quem somos", sobre_path, class: "hover:text-[#485057] transition" %>
              </li>

              <li>
                <%= link_to "Seja nosso Creator",
                    "https://docs.google.com/forms/d/e/1FAIpQLSfXEZrLjodIRCHPCz1w6oO8nCi4Ndxn6cjrGXjjW0DmFvJi0g/viewform?usp=publish-editor",
                    class: "hover:text-[#485057] transition" %>
              </li>
            </ul>
          </div>

          <div>
            <h3 class="font-semibold text-base mb-5">Entre em contato</h3>

            <p class="text-sm text-[#737980] leading-relaxed">
              Ficou com alguma dúvida? Entre em contato com a Maison Parfum
              pelos nossos canais de atendimento.
            </p>

            <% if configuracao_loja.email_contato.present? %>
              <p class="mt-3 text-sm text-[#737980]">
                <%= mail_to configuracao_loja.email_contato,
                    configuracao_loja.email_contato,class: "hover:text-[#485057] transition" %>
              </p>
            <% end %>

            <div class="mt-6">
              <h4 class="font-semibold text-sm mb-3">Redes sociais</h4>
              <div class="flex items-center gap-3">
                <% if configuracao_loja.instagram_url.present? %>
                  <a href="<%= configuracao_loja.instagram_url %>" aria-label="Instagram" target="_blank" rel="noopener noreferrer" class="w-10 h-10 rounded-full bg-[#485057] text-white flex items-center justify-center hover:bg-[#748A9C] transition">
                    <i class="fa-brands fa-instagram text-xl"></i>
                  </a>
                <% end %>

                <% if configuracao_loja.whatsapp.present? %>
                  <a href="https://wa.me/<%= configuracao_loja.whatsapp.gsub(/\D/, '') %>" aria-label="WhatsApp" target="_blank" rel="noopener noreferrer" class="w-10 h-10 rounded-full bg-[#485057] text-white flex items-center justify-center hover:bg-[#748A9C] transition">
                    <i class="fa-brands fa-whatsapp text-xl"></i>
                  </a>
                <% end %>
              </div>
            </div>
          </div>
        </div>

        <div class="border-t border-[#D0D3D6] mt-10 pt-6 text-center">
          <p class="text-xs text-[#737980]">
            © <%= Date.current.year %> Maison Parfum. Todos os direitos reservados.
          </p>
        </div>
      </div>
    </footer>
    <% unless current_usuario&.admin? || controller_path.start_with?("admin") %>
      <% if login_page %>
        <div class="hidden md:block"><%= render "shared/atalhos_flutuantes" %></div>
      <% else %>
        <%= render "shared/atalhos_flutuantes" %>
      <% end %>
    <% end %>
  </body>
</html>
