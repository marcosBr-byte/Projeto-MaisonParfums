<% content_for :title, "Editar perfil · Maison Parfum" %>
<% voltar = resource.admin? ? admin_perfil_path : perfil_path %>
<div class="account-page account-page--edit">
  <nav class="account-breadcrumb" aria-label="Navegação estrutural">
    <%= link_to "Meu perfil", voltar %><span aria-hidden="true">/</span><span aria-current="page">Editar dados</span>
  </nav>
  <header class="account-heading"><div><p class="account-eyebrow">Do seu jeito</p><h1>Editar perfil</h1><p>Seus dados atualizados, sua experiência ainda melhor.</p></div><%= link_to "← Voltar ao perfil", voltar, class: "account-back-link" %></header>

  <div class="account-layout">
    <aside class="account-sidebar" aria-label="Navegação do perfil">
      <%= render "shared/profile_identity", usuario: resource %>
      <nav class="account-section-nav" aria-label="Seções da edição">
        <a href="#dados-pessoais"><span class="material-symbols-outlined" aria-hidden="true">person</span> Dados pessoais <span aria-hidden="true">↗</span></a>
        <% unless resource.admin? %><a href="#endereco"><span class="material-symbols-outlined" aria-hidden="true">location_on</span> Endereço <span aria-hidden="true">↗</span></a><% end %>
        <a href="#seguranca"><span class="material-symbols-outlined" aria-hidden="true">lock</span> Senha e confirmação <span aria-hidden="true">↗</span></a>
      </nav>
    </aside>

    <div class="account-panels">
      <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put, class: "account-form", data: { turbo: false } }) do |f| %>
        <%= render "devise/shared/error_messages", resource: resource %>
        <section id="dados-pessoais" class="account-card">
          <div class="account-card-heading"><span class="account-section-icon material-symbols-outlined" aria-hidden="true">person</span><div><h2>Dados pessoais</h2><p>Como podemos identificar e entrar em contato com você.</p></div><span class="account-step" aria-hidden="true">01</span></div>
          <div class="account-card-body">
            <div class="account-photo-field"><span class="account-photo-icon material-symbols-outlined" aria-hidden="true">add_a_photo</span><div><%= f.label :imagem, "Sua foto de perfil" %><p>JPG, PNG ou WebP de até 5 MB.</p><%= f.file_field :imagem, accept: "image/png,image/jpeg,image/webp" %></div></div>
            <div class="account-fields">
              <div class="account-field account-field--wide"><%= f.label :nome, "Nome completo" %><%= f.text_field :nome, autocomplete: "name", required: true %></div>
              <div class="account-field account-field--wide"><%= f.label :email, "E-mail de acesso" %><%= f.email_field :email, autocomplete: "email", required: true %><p>Use este e-mail para entrar na sua conta.</p></div>
              <div class="account-field"><%= f.label :telefone, "Telefone com DDD" %><%= f.telephone_field :telefone, autocomplete: "tel", placeholder: "(83) 99999-9999" %></div>
              <div class="account-field"><%= f.label :cpf, "CPF (opcional)" %><%= f.text_field :cpf, inputmode: "numeric", placeholder: "000.000.000-00" %></div>
            </div>
            <% if devise_mapping.confirmable? && resource.pending_reconfirmation? %><p class="account-hint">Aguardando confirmação para: <%= resource.unconfirmed_email %></p><% end %>
          </div>
        </section>

        <% unless resource.admin? %>
        <section id="endereco" class="account-card">
          <div class="account-card-heading"><span class="account-section-icon material-symbols-outlined" aria-hidden="true">location_on</span><div><h2>Endereço</h2><p>Preencha os detalhes para facilitar suas entregas.</p></div><span class="account-step" aria-hidden="true">02</span></div>
          <div class="account-card-body account-fields">
            <div class="account-field"><%= f.label :cep, "CEP" %><%= f.text_field :cep, autocomplete: "postal-code", inputmode: "numeric", placeholder: "00000-000" %></div>
            <div class="account-field"><%= f.label :estado, "Estado" %><%= f.select :estado, Usuario::ESTADOS, { include_blank: "Selecione o estado" }, autocomplete: "address-level1" %></div>
            <div class="account-field"><%= f.label :cidade, "Cidade" %><%= f.text_field :cidade, autocomplete: "address-level2", placeholder: "Sua cidade" %></div>
            <div class="account-field"><%= f.label :bairro, "Bairro" %><%= f.text_field :bairro, autocomplete: "address-level3" %></div>
            <div class="account-field"><%= f.label :rua, "Rua / Avenida" %><%= f.text_field :rua, autocomplete: "address-line1" %></div>
            <div class="account-field"><%= f.label :numero_casa, "Número" %><%= f.text_field :numero_casa, placeholder: "Número ou S/N" %></div>
            <div class="account-field account-field--wide"><%= f.label :complemento, "Complemento (opcional)" %><%= f.text_field :complemento, autocomplete: "address-line2", placeholder: "Apartamento, bloco, casa dos fundos…" %></div>
            <div class="account-field account-field--wide"><%= f.label :ponto_referencia, "Ponto de referência (opcional)" %><%= f.text_field :ponto_referencia, placeholder: "Um lugar conhecido por perto" %></div>
          </div>
        </section>

        <% end %>

        <section id="seguranca" class="account-card">
          <div class="account-card-heading"><span class="account-section-icon material-symbols-outlined" aria-hidden="true">lock</span><div><h2>Senha e confirmação</h2><p>Você só precisa criar uma nova senha se quiser alterá-la.</p></div><span class="account-step" aria-hidden="true"><%= resource.admin? ? "02" : "03" %></span></div>
          <div class="account-card-body">
            <div class="account-fields">
              <div class="account-field"><%= f.label :password, "Nova senha (opcional)" %><%= f.password_field :password, autocomplete: "new-password", placeholder: "Deixe em branco para manter" %><% if @minimum_password_length %><p>Mínimo de <%= @minimum_password_length %> caracteres.</p><% end %></div>
              <div class="account-field"><%= f.label :password_confirmation, "Confirmar nova senha" %><%= f.password_field :password_confirmation, autocomplete: "new-password", placeholder: "Repita a nova senha" %></div>
            </div>
            <div class="account-confirmation"><span class="material-symbols-outlined" aria-hidden="true">shield_lock</span><div class="account-field"><%= f.label :current_password, "Confirme com sua senha atual" %><%= f.password_field :current_password, autocomplete: "current-password", required: true, placeholder: "Sua senha atual" %><p>Necessária para salvar qualquer alteração no perfil.</p></div></div>
          </div>
        </section>

        <div class="account-form-actions"><p><span class="material-symbols-outlined" aria-hidden="true">check_circle</span> Tudo pronto? Salve suas alterações.</p><div><%= link_to "Cancelar", voltar, class: "account-button account-button--quiet" %><%= f.button type: :submit, class: "account-button account-button--primary" do %><span class="material-symbols-outlined" aria-hidden="true">check</span> Salvar alterações<% end %></div></div>
      <% end %>

      <details class="account-close"><summary>Encerrar minha conta</summary><p>O cancelamento remove sua conta e não pode ser desfeito.</p><%= button_to "Cancelar minha conta", registration_path(resource_name), method: :delete, data: { turbo_confirm: "Tem certeza? Essa ação não pode ser desfeita." }, class: "account-delete-button" %></details>
    </div>
  </div>
</div>
