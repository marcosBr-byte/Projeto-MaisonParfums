<div class="min-h-screen flex flex-col items-center justify-center bg-gray-50 px-3 py-6 sm:px-6 sm:py-10">

  <div class="w-full max-w-xl lg:max-w-2xl mx-auto">

    <div class="bg-white px-4 py-6 sm:px-8 sm:py-9 lg:px-10 lg:py-10 rounded-xl border border-gray-200 shadow-sm">

      <!-- Título -->
      <h2 class="text-xl sm:text-2xl lg:text-3xl font-semibold text-gray-900 text-center mb-2 sm:mb-3">
        Editar perfil
      </h2>

      <p class="text-xs sm:text-sm lg:text-base text-gray-500 text-center mb-6 sm:mb-8">
        Atualize suas informações pessoais e mantenha sua conta segura.
      </p>

      <!-- Formulário do Devise -->
      <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put }) do |f| %>

        <% field_classes = "w-full h-11 sm:h-12 px-3 sm:px-4 text-sm text-gray-900 bg-white border border-gray-300 rounded-lg outline-none placeholder:text-gray-400 transition duration-200 hover:border-gray-400 focus:border-gray-700 focus:ring-2 focus:ring-gray-200" %>

        <% label_classes = "block text-sm font-medium text-gray-700 mb-1.5 sm:mb-2" %>

        <!-- Mensagens de erro -->
        <%= render "devise/shared/error_messages", resource: resource %>

        <!-- E-mail -->
        <div class="mb-4 sm:mb-5">

          <%= f.label :email, "E-mail", class: label_classes %>

          <%= f.email_field :email,
              autofocus: true,
              autocomplete: "email",
              placeholder: "Digite seu e-mail",
              class: field_classes %>

        </div>

        <!-- Confirmação pendente -->
        <% if devise_mapping.confirmable? && resource.pending_reconfirmation? %>
          <div class="mb-4 rounded-lg border border-gray-200 bg-gray-50 px-3 py-3 text-sm text-gray-600 wrap-break-word">
            Aguardando confirmação para:
            <strong><%= resource.unconfirmed_email %></strong>
          </div>
        <% end %>

        <!-- Separador -->
        <div class="flex items-center gap-2 sm:gap-3 my-6 sm:my-7">
          <div class="h-px bg-gray-200 flex-1"></div>
          <span class="text-xs text-gray-400 uppercase tracking-wide">
            Alterar senha
          </span>
          <div class="h-px bg-gray-200 flex-1"></div>
        </div>

        <p class="text-xs sm:text-sm text-gray-500 mb-5">
          Preencha os campos abaixo somente se desejar alterar sua senha.
        </p>

        <!-- Nova senha -->
        <div class="mb-4 sm:mb-5">

          <%= f.label :password, "Nova senha", class: label_classes %>

          <% if @minimum_password_length %>
            <p class="text-xs text-gray-500 mb-2">
              Mínimo de <%= @minimum_password_length %> caracteres.
            </p>
          <% end %>

          <%= f.password_field :password,
              autocomplete: "new-password",
              placeholder: "Digite sua nova senha",
              class: field_classes %>

        </div>

        <!-- Confirmação da senha -->
        <div class="mb-4 sm:mb-5">

          <%= f.label :password_confirmation, "Confirmar nova senha", class: label_classes %>

          <%= f.password_field :password_confirmation,
              autocomplete: "new-password",
              placeholder: "Digite sua nova senha novamente",
              class: field_classes %>

        </div>

        <!-- Senha atual -->
        <div class="mb-5 sm:mb-6">

          <%= f.label :current_password, "Senha atual", class: label_classes %>

          <p class="text-xs text-gray-500 mb-2">
            Necessária para confirmar as alterações da sua conta.
          </p>

          <%= f.password_field :current_password,
              autocomplete: "current-password",
              placeholder: "Digite sua senha atual",
              class: field_classes %>

        </div>

        <!-- Botão atualizar -->
        <div class="actions">

          <%= f.submit "Salvar alterações",
              class: "w-full h-11 sm:h-12 bg-gray-900 hover:bg-gray-700 active:bg-gray-950 text-white text-sm font-semibold rounded-lg cursor-pointer transition duration-200" %>

        </div>

      <% end %>

      <!-- Separador -->
      <div class="flex items-center gap-2 sm:gap-3 my-6 sm:my-7">
        <div class="h-px bg-gray-200 flex-1"></div>
        <span class="text-xs text-gray-400 uppercase tracking-wide">
          Conta
        </span>
        <div class="h-px bg-gray-200 flex-1"></div>
      </div>

      <!-- Cancelar conta -->
      <div class="rounded-lg border border-gray-200 p-4 sm:p-5">

        <h3 class="text-base sm:text-lg font-semibold text-gray-900 mb-2">
          Cancelar minha conta
        </h3>

        <p class="text-xs sm:text-sm text-gray-500 mb-4">
          Se não deseja mais utilizar sua conta, você pode excluí-la permanentemente.
        </p>

        <%= button_to "Cancelar minha conta",
            registration_path(resource_name),
            method: :delete,
            data: {
              turbo_confirm: "Tem certeza de que deseja cancelar sua conta? Essa ação não poderá ser desfeita."
            },
            class: "w-full sm:w-auto min-h-11 px-4 py-2 bg-white border border-gray-300 hover:bg-gray-100 text-gray-700 text-sm font-semibold rounded-lg cursor-pointer transition duration-200" %>

      </div>

    </div>

    <!-- Voltar -->
    <div class="bg-white border border-gray-200 rounded-xl mt-4 sm:mt-5 py-4 sm:py-5 px-3 sm:px-4 text-center text-xs sm:text-sm shadow-sm">

      <%= link_to "Voltar",
          :back,
          class: "font-semibold text-gray-900 hover:text-gray-500 transition duration-200" %>

    </div>

  </div>

</div>