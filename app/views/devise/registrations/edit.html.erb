<div class="min-h-screen flex flex-col items-center justify-center bg-gray-50 px-3 py-6 sm:px-6 sm:py-10">

  <div class="w-full max-w-xl lg:max-w-2xl mx-auto">

    <div class="bg-white px-4 py-6 sm:px-8 sm:py-9 lg:px-10 lg:py-10 rounded-xl border border-gray-200 shadow-sm">

      <h2 class="text-xl sm:text-2xl lg:text-3xl font-semibold text-gray-900 text-center mb-2 sm:mb-3">
        Editar conta
      </h2>

      <p class="text-xs sm:text-sm lg:text-base text-gray-500 text-center mb-6 sm:mb-8">
        Altere seus dados de acesso, seus dados pessoais e seu endereço.
      </p>

      <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put }) do |f| %>
        <%= render "devise/shared/error_messages", resource: resource %>

        <% field_classes = "w-full h-11 sm:h-12 px-3 sm:px-4 text-sm text-gray-900 bg-white border border-gray-300 rounded-lg outline-none placeholder:text-gray-400 transition duration-200 hover:border-gray-400 focus:border-gray-700 focus:ring-2 focus:ring-gray-200" %>
        <% label_classes = "block text-sm font-medium text-gray-700 mb-1.5 sm:mb-2" %>

        <div class="mb-4 sm:mb-5">
          <%= f.label :email, "E-mail", class: label_classes %>
          <%= f.email_field :email, autofocus: true, autocomplete: "email", class: field_classes %>
        </div>

        <% if devise_mapping.confirmable? && resource.pending_reconfirmation? %>
          <p class="text-sm text-gray-600 mb-4">Aguardando confirmação para: <%= resource.unconfirmed_email %></p>
        <% end %>

        <div class="mb-4 sm:mb-5">
          <%= f.label :cpf, "CPF (opcional)", class: label_classes %>
          <%= f.text_field :cpf, placeholder: "000.000.000-00", class: field_classes %>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 sm:gap-5 mb-4 sm:mb-5">
          <div>
            <%= f.label :cep, "CEP", class: label_classes %>
            <%= f.text_field :cep, autocomplete: "postal-code", placeholder: "00000-000", class: field_classes %>
          </div>

          <div>
            <%= f.label :estado, "Estado", class: label_classes %>
            <%= f.select :estado, Usuario::ESTADOS, { include_blank: "Selecione" }, class: field_classes %>
          </div>

          <div>
            <%= f.label :cidade, "Cidade", class: label_classes %>
            <%= f.text_field :cidade, autocomplete: "address-level2", class: field_classes %>
          </div>

          <div>
            <%= f.label :bairro, "Bairro", class: label_classes %>
            <%= f.text_field :bairro, class: field_classes %>
          </div>

          <div>
            <%= f.label :rua, "Rua / Avenida", class: label_classes %>
            <%= f.text_field :rua, autocomplete: "street-address", class: field_classes %>
          </div>

          <div>
            <%= f.label :numero_casa, "Número", class: label_classes %>
            <%= f.text_field :numero_casa, class: field_classes %>
          </div>

          <div class="sm:col-span-2">
            <%= f.label :complemento, "Complemento (opcional)", class: label_classes %>
            <%= f.text_field :complemento, placeholder: "Apartamento, bloco, casa dos fundos...", class: field_classes %>
          </div>

          <div class="sm:col-span-2">
            <%= f.label :ponto_referencia, "Ponto de referência (opcional)", class: label_classes %>
            <%= f.text_field :ponto_referencia, placeholder: "Ex.: próximo à praça central", class: field_classes %>
          </div>
        </div>

        <div class="mb-4 sm:mb-5">
          <%= f.label :password, "Nova senha", class: label_classes %>
          <%= f.password_field :password, autocomplete: "new-password", placeholder: "Deixe em branco para não alterar", class: field_classes %>
          <% if @minimum_password_length %>
            <p class="text-xs text-gray-500 mt-1.5">Mínimo de <%= @minimum_password_length %> caracteres.</p>
          <% end %>
        </div>

        <div class="mb-4 sm:mb-5">
          <%= f.label :password_confirmation, "Confirmar nova senha", class: label_classes %>
          <%= f.password_field :password_confirmation, autocomplete: "new-password", placeholder: "Repita a nova senha", class: field_classes %>
        </div>

        <div class="mb-5 sm:mb-6">
          <%= f.label :current_password, "Senha atual", class: label_classes %>
          <%= f.password_field :current_password, autocomplete: "current-password", placeholder: "Necessária para confirmar as alterações", class: field_classes %>
        </div>

        <div class="actions">
          <%= f.submit "Atualizar", class: "w-full h-11 sm:h-12 bg-gray-900 hover:bg-gray-700 active:bg-gray-950 text-white text-sm font-semibold rounded-lg cursor-pointer transition duration-200" %>
        </div>
      <% end %>

      <div class="flex items-center gap-2 sm:gap-3 my-6 sm:my-7">
        <div class="h-px bg-gray-200 flex-1"></div>
        <span class="text-xs text-gray-400 uppercase tracking-wide">ou</span>
        <div class="h-px bg-gray-200 flex-1"></div>
      </div>

      <div class="text-center text-sm text-gray-600">
        <%= link_to "Voltar", :back, class: "font-semibold text-gray-900 hover:text-gray-500 transition duration-200" %>
      </div>

    </div>

    <div class="bg-white border border-gray-200 rounded-xl mt-4 sm:mt-5 py-4 sm:py-5 px-3 sm:px-4 text-center text-xs sm:text-sm shadow-sm">
      <p class="text-gray-600 mb-3">Não quer mais usar a loja?</p>
      <%= button_to "Cancelar minha conta", registration_path(resource_name),method: :delete,data: { turbo_confirm: "Tem certeza? Essa ação não pode ser desfeita." },class: "text-red-700 hover:text-red-500 font-semibold cursor-pointer transition duration-200" %>
    </div>

  </div>

</div>