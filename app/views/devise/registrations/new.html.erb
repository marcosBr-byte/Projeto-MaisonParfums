<div class="min-h-screen flex flex-col items-center justify-center bg-gray-50 px-3 py-6 sm:px-6 sm:py-10">

  <div class="w-full max-w-xl lg:max-w-2xl mx-auto">

    <div class="bg-white px-4 py-6 sm:px-8 sm:py-9 lg:px-10 lg:py-10 rounded-xl border border-gray-200 shadow-sm">

      <h2 class="text-xl sm:text-2xl lg:text-3xl font-semibold text-gray-900 text-center mb-2 sm:mb-3">
        Criar sua conta
      </h2>

      <p class="text-xs sm:text-sm lg:text-base text-gray-500 text-center mb-6 sm:mb-8">
        Crie sua conta e acompanhe seus pedidos em um só lugar.
      </p>

      <%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>

        <% field_classes = "w-full h-11 sm:h-12 px-3 sm:px-4 text-sm text-gray-900 bg-white border border-gray-300 rounded-lg outline-none placeholder:text-gray-400 transition duration-200 hover:border-gray-400 focus:border-gray-700 focus:ring-2 focus:ring-gray-200" %>

        <% label_classes = "block text-sm font-medium text-gray-700 mb-1.5 sm:mb-2" %>

        <%= render "devise/shared/error_messages", resource: resource %>

        <div class="mb-4 sm:mb-5">
          <%= f.label :nome, "Nome completo", class: label_classes %>
          <%= f.text_field :nome,autofocus: true,autocomplete: "name",placeholder: "Digite seu nome completo",class: field_classes %>
        </div>

        <div class="mb-4 sm:mb-5">
          <%= f.label :telefone, "Telefone", class: label_classes %>
          <%= f.telephone_field :telefone,autocomplete: "tel",placeholder: "(00) 00000-0000",class: field_classes %>
        </div>

        <div class="mb-4 sm:mb-5">
          <%= f.label :email, "E-mail", class: label_classes %>
          <%= f.email_field :email,autocomplete: "email",placeholder: "Digite seu e-mail",class: field_classes %>
        </div>

        <div class="mb-4 sm:mb-5">
          <%= f.label :password, "Senha", class: label_classes %>
          <% if @minimum_password_length %>
            <p class="text-xs text-gray-500 mb-2">
              Mínimo de <%= @minimum_password_length %> caracteres.
            </p>
          <% end %>

          <%= f.password_field :password, autocomplete: "new-password",placeholder: "Crie uma senha",class: field_classes %>
        </div>

        <div class="mb-5 sm:mb-6">
          <%= f.label :password_confirmation, "Confirmar senha", class: label_classes %>
          <%= f.password_field :password_confirmation,autocomplete: "new-password",placeholder: "Digite sua senha novamente",class: field_classes %>
        </div>

        <div class="actions">
          <%= f.submit "Criar conta",class: "w-full h-11 sm:h-12 bg-gray-900 hover:bg-gray-700 active:bg-gray-950 text-white text-sm font-semibold rounded-lg cursor-pointer transition duration-200" %>
        </div>

      <% end %>

      <div class="flex items-center gap-2 sm:gap-3 my-6 sm:my-7">
        <div class="h-px bg-gray-200 flex-1"></div>
        <span class="text-xs text-gray-400 uppercase tracking-wide">ou</span>
        <div class="h-px bg-gray-200 flex-1"></div>
      </div>

      <div class="text-center text-sm text-gray-600">
        <%= render "devise/shared/links" %>
      </div>

    </div>

    <div class="bg-white border border-gray-200 rounded-xl mt-4 sm:mt-5 py-4 sm:py-5 px-3 sm:px-4 text-center text-xs sm:text-sm shadow-sm">
      <span class="text-gray-600">Já tem uma conta?</span>

      <%= link_to "Entrar",new_session_path(resource_name),class: "font-semibold text-gray-900 hover:text-gray-500 transition duration-200" %>
    </div>

  </div>

</div>