<% content_for :login_page, "true" %>

<div class="bg-gray-50 px-4 py-6 sm:px-6 sm:py-10">

  <div class="w-full max-w-md mx-auto">

    <div class="bg-white px-5 py-6 sm:p-8 rounded-xl border border-gray-200 shadow-sm">

      <h1 class="text-2xl sm:text-3xl font-semibold text-gray-900 text-center mb-4">
        Entrar na sua conta
      </h1>

      <%= render "shared/notifications", compact: true %>

      <% if Usuario.omniauth_providers.any? %>
        <%= render "devise/shared/social_login" %>
        <div class="flex items-center gap-3 my-4 text-sm text-gray-600">
          <span class="h-px bg-gray-200 flex-1" aria-hidden="true"></span>
          ou entre com e-mail
          <span class="h-px bg-gray-200 flex-1" aria-hidden="true"></span>
        </div>
      <% end %>

      <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>

        <% field_classes = "w-full h-12 px-3 sm:px-4 text-base text-gray-900 bg-white border border-gray-300 rounded-lg outline-none placeholder:text-gray-400 transition duration-200 hover:border-gray-400 focus:border-gray-700 focus:ring-2 focus:ring-gray-200" %>

        <% label_classes = "block text-sm font-medium text-gray-700 mb-1.5 sm:mb-2" %>

        <!-- E-mail -->
        <div class="mb-4 sm:mb-5">
          <%= f.label :email, "E-mail", class: label_classes %>
          <%= f.email_field :email, autocomplete: "email", class: field_classes %>
        </div>

        <div class="mb-4 sm:mb-5">
          <%= f.label :password, "Senha", class: label_classes %>
          <%= f.password_field :password, autocomplete: "current-password", placeholder: "Digite sua senha", class: field_classes %>
        </div>

        <% if devise_mapping.rememberable? %>
          <div class="flex items-center gap-2 mb-5 sm:mb-6">
            <%= f.check_box :remember_me, class: "w-4 h-4 rounded border-gray-300 accent-gray-900 cursor-pointer" %>
            <%= f.label :remember_me, "Lembrar de mim", class: "text-sm text-gray-600 cursor-pointer" %>
          </div>
        <% end %>

        <div class="actions">
          <%= f.submit "Entrar", class: "w-full h-12 bg-gray-900 hover:bg-gray-700 active:bg-gray-950 text-white text-sm font-semibold rounded-lg cursor-pointer transition duration-200" %>
        </div>

      <% end %>

      <div class="text-center text-sm text-gray-600 mt-4 space-y-2">
        <%= render "devise/shared/links", show_registration: false %>
        <% if devise_mapping.registerable? %>
          <p>Não tem uma conta? <%= link_to "Cadastre-se", new_registration_path(resource_name), class: "font-semibold text-gray-900 underline" %></p>
        <% end %>
      </div>
    </div>
  </div>
</div>
