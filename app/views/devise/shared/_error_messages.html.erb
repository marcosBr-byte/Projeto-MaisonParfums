<% if resource.errors.any? %>
  <div id="error_explanation" class="system-message system-message--attention system-form-errors" role="alert" data-turbo-temporary>
    <span class="material-symbols-outlined system-message__icon" aria-hidden="true">info</span>
    <div class="system-message__content">
      <h2 class="system-message__title">Confira os dados para continuar</h2>
      <p class="system-message__text">Ajuste os campos abaixo e tente novamente.</p>
      <ul>
        <% resource.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  </div>
<% end %>
